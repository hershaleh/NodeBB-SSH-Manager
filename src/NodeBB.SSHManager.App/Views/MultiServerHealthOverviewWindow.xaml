<Window x:Class="NodeBB.SSHManager.Views.MultiServerHealthOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניטור מצב כל השרתים" Width="1250" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="תמונת מצב של כלל השרתים" FontSize="24" FontWeight="Bold" Foreground="#18243A"/>
                <TextBlock Text="איסוף מקבילי מבוקר · ללא התחברות אוטומטית וללא אישור אוטומטי של מפתחות SSH"
                           Foreground="#718096" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="ייצוא CSV" Click="Export_Click" Padding="15,9" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="רענן נתונים" Click="Refresh_Click" Padding="15,9"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="שרתים במאגר" Foreground="#718096"/><TextBlock x:Name="TotalCount" FontSize="25" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="נגישים" Foreground="#718096"/><TextBlock x:Name="ReachableCount" FontSize="25" FontWeight="Bold" Foreground="#16865D"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="לא מחוברים / נכשלו" Foreground="#718096"/><TextBlock x:Name="UnavailableCount" FontSize="25" FontWeight="Bold" Foreground="#B7791F"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14">
                <StackPanel><TextBlock Text="שרתים עם התרעות" Foreground="#718096"/><TextBlock x:Name="AlertCount" FontSize="25" FontWeight="Bold" Foreground="#C05656"/></StackPanel>
            </Border>
        </UniformGrid>
        <DataGrid x:Name="HealthGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFD"
                  BorderBrush="#E3E9F1" BorderThickness="1" SelectionMode="Single"
                  FlowDirection="RightToLeft" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="שרת" Binding="{Binding ServerName}" Width="1.1*"/>
                <DataGridTextColumn Header="כתובת" Binding="{Binding Endpoint}" Width="1.2*"/>
                <DataGridTextColumn Header="מצב" Binding="{Binding ConnectionState}" Width="1*"/>
                <DataGridTextColumn Header="מעבד" Binding="{Binding Cpu}" Width="0.6*"/>
                <DataGridTextColumn Header="זיכרון" Binding="{Binding Memory}" Width="0.6*"/>
                <DataGridTextColumn Header="Swap" Binding="{Binding Swap}" Width="0.6*"/>
                <DataGridTextColumn Header="דיסק" Binding="{Binding Disk}" Width="1.5*"/>
                <DataGridTextColumn Header="רשת" Binding="{Binding Network}" Width="1.1*"/>
                <DataGridTextColumn Header="התרעות / שגיאות" Binding="{Binding Alerts}" Width="2*"/>
                <DataGridTextColumn Header="נאסף בתאריך" Binding="{Binding CollectedAt}" Width="1.1*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#718096" FontSize="11" Margin="0,12,0,0"
                   Text="הנתונים נאספים רק מחיבורי SSH שכבר אומתו ונפתחו."/>
    </Grid>
</Window>
