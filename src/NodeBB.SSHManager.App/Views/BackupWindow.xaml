<Window x:Class="NodeBB.SSHManager.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="גיבויים" Width="720" Height="690" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="גיבוי התקנת NodeBB" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="InstallationLabel" Foreground="#778399" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20">
            <StackPanel>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="גיבוי מלא של תיקיית NodeBB" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="יוצר ארכיון של כל תיקיית ההתקנה, כולל קבצים ותלויות. הגיבוי עלול להיות גדול." TextWrapping="Wrap" Foreground="#778399" Margin="0,7,0,12"/>
                        <Button Content="יצירת גיבוי מלא" Click="FullBackup_Click" HorizontalAlignment="Left" Padding="16,9" Background="#4263EB" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="גיבוי הגדרות והעלאות" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="כולל config.json, קובצי package/lock וקובצי public/uploads שנמצאו. אינו כולל את מסד הנתונים." TextWrapping="Wrap" Foreground="#778399" Margin="0,7,0,12"/>
                        <Button Content="יצירת גיבוי ממוקד" Click="EssentialBackup_Click" HorizontalAlignment="Left" Padding="16,9"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="מדיניות שמירת גיבויים" FontWeight="SemiBold"/>
                        <TextBlock Text="הניקוי חל רק על גיבויים של השרת הזה ובאותו סוג גיבוי. ברירת המחדל אינה מוחקת גיבויים." Foreground="#778399" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <ComboBox x:Name="RetentionComboBox" SelectedIndex="0" Padding="7">
                            <ComboBoxItem Content="ללא מחיקה אוטומטית" Tag="0"/>
                            <ComboBoxItem Content="לשמור 5 גיבויים אחרונים" Tag="5"/>
                            <ComboBoxItem Content="לשמור 10 גיבויים אחרונים" Tag="10"/>
                            <ComboBoxItem Content="לשמור 20 גיבויים אחרונים" Tag="20"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <CheckBox x:Name="EncryptBackupCheckBox" Content="הצפן את קובץ הגיבוי (מומלץ)" IsChecked="True" Click="EncryptionOption_Changed" FontWeight="SemiBold"/>
                        <StackPanel x:Name="EncryptionFields" Margin="0,10,0,0">
                            <TextBlock Text="סיסמת הצפנה (לפחות 12 תווים)" Foreground="#778399" FontSize="11"/>
                            <PasswordBox x:Name="EncryptionPasswordBox" Padding="9" Margin="0,4,0,8"/>
                            <TextBlock Text="אימות סיסמה" Foreground="#778399" FontSize="11"/>
                            <PasswordBox x:Name="EncryptionConfirmBox" Padding="9" Margin="0,4,0,0"/>
                            <TextBlock Text="הסיסמה אינה נשמרת. בלעדיה לא ניתן יהיה לפענח את הגיבוי." Foreground="#9A5B13" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="שחזור גיבוי הגדרות והעלאות" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="אפשר לשחזר גיבוי ממוקד של config.json והעלאות. מסד הנתונים אינו משתנה, וקובצי package/lock אינם משוחזרים." TextWrapping="Wrap" Foreground="#778399" Margin="0,7,0,10"/>
                        <TextBlock Text="סיסמת הגיבוי (רק אם הקובץ מוצפן)" Foreground="#778399" FontSize="11"/>
                        <PasswordBox x:Name="RestorePasswordBox" Padding="9" Margin="0,4,0,10"/>
                        <Button x:Name="RestoreEssentialButton" Content="בחירת גיבוי ושחזור הגדרות והעלאות" Click="RestoreEssential_Click" HorizontalAlignment="Left" Padding="16,9" Background="#A23B3B" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="חשוב: גיבויי קבצים אינם כוללים את תוכן מסד הנתונים. שחזור config.json מחזיר גם הגדרות חיבור ופרטי גישה, ולכן התוכנה מוודאת שסוג מסד הנתונים והשרת/מסד היעד תואמים להתקנה הנוכחית. ארכיון התקנה מלא אינו נתמך בשחזור זה. שמור תמיד גם גיבוי מסד נתונים נפרד." TextWrapping="Wrap" Foreground="#8A4B08"/>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="#778399" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="סגור" Click="Close_Click" HorizontalAlignment="Left" Padding="18,9"/>
    </Grid>
</Window>