<Window x:Class="NodeBB.SSHManager.Views.SecurityAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בדיקת אבטחה" Width="1040" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="בדיקת אבטחת השרת" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="InstallationLabel" Foreground="#778399" Margin="0,5,0,0"/>
            <TextBlock Text="בדיקה לקריאה בלבד. התוכנה אינה משנה הגדרות אבטחה או הרשאות." Foreground="#17633B" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <Button x:Name="RefreshButton" Content="הרצת בדיקה מחדש" Click="Refresh_Click" Padding="16,9" Background="#4263EB" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
        </DockPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="10">
            <ListView x:Name="FindingsList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="רמה" Width="105" DisplayMemberBinding="{Binding Severity}"/>
                        <GridViewColumn Header="בדיקה" Width="210" DisplayMemberBinding="{Binding Item}"/>
                        <GridViewColumn Header="מצב נוכחי" Width="250" DisplayMemberBinding="{Binding CurrentValue}"/>
                        <GridViewColumn Header="המלצה" Width="400" DisplayMemberBinding="{Binding Recommendation}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="3" Text="הדוח מספק אינדיקציות בלבד. יש לבדוק ידנית כל המלצה לפני שינוי תצורת SSH, חומת אש או הרשאות." Foreground="#778399" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
