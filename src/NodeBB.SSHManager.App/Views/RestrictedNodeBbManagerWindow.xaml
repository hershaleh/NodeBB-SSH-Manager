<Window x:Class="NodeBB.SSHManager.Views.RestrictedNodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ניהול NodeBB — גישת SSH מוגבלת" Width="900" Height="720" MinWidth="700" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="ניהול NodeBB" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
   <TextBlock x:Name="ServerLabel" Foreground="#778399" Margin="0,5,0,0"/>
   <TextBlock Text="זוהה ממשק SSH מוגבל. כל הפעולות כאן משתמשות רק בפקודות שאושרו על ידי מנהל השרת." Foreground="#18794E" Margin="0,8,0,0"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,16,0,12">
   <Button Content="רשימת תוספים" Click="List_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="גיבוי מלא" Click="Backup_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="סטטוס הפורום" Click="Status_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="לוגים" Click="Logs_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="בנייה" Click="Build_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="הפעלה מחדש" Click="Restart_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="רשימת ZIP בשרת" Click="Zips_Click" Padding="12,8" Margin="0,0,7,7"/>
   <Button Content="עזרה" Click="Help_Click" Padding="12,8" Margin="0,0,7,7"/>
  </WrapPanel>
  <TextBox x:Name="OutputBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
   FlowDirection="LeftToRight" Background="#101828" Foreground="#E6EDF7" Padding="12"/>
  <Border Grid.Row="3" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="ניהול תוספים" FontWeight="SemiBold" FontSize="15"/>
    <Grid Margin="0,8,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="חבילה / כתובת GitHub / קובץ ZIP:" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <TextBox x:Name="TargetBox" Grid.Column="1" Height="34" Padding="8" FlowDirection="LeftToRight"/>
    </Grid>
    <WrapPanel>
     <Button Content="התקנה" Click="Install_Click" Padding="13,8" Margin="0,0,7,0" Background="#4263EB" Foreground="White"/>
     <Button Content="עדכון" Click="Update_Click" Padding="13,8" Margin="0,0,7,0"/>
     <Button Content="הפעלה" Click="Activate_Click" Padding="13,8" Margin="0,0,7,0"/>
     <Button Content="השבתה" Click="Disable_Click" Padding="13,8" Margin="0,0,7,0"/>
     <Button Content="הסרה" Click="Remove_Click" Padding="13,8" Margin="0,0,7,0"/>
     <Button Content="מחיקת ZIP" Click="DeleteZip_Click" Padding="13,8"/>
    </WrapPanel>
    <TextBlock Text="הערה: לפני התקנה, עדכון או הסרה מומלץ לבצע גיבוי. ההתקנה מהשרת תומכת ב־npm, GitHub ציבורי וקובץ ZIP שכבר הועלה לתיקיית ההעלאות." TextWrapping="Wrap" Foreground="#778399" FontSize="11" Margin="0,9,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>