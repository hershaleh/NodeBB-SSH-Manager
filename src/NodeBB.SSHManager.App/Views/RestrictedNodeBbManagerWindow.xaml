<Window x:Class="NodeBB.SSHManager.Views.RestrictedNodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NodeBB · סביבת ניהול" Width="1180" Height="850" MinWidth="940" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft" FontFamily="Segoe UI">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#111C31" Offset="0"/>
   <GradientStop Color="#5268D9" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#26364F"/>
   <Setter Property="BorderBrush" Value="#DCE4F0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="buttonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin=".5,.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonSurface" Property="BorderBrush" Value="#9BAFDC"/><Setter TargetName="buttonSurface" Property="Background" Value="#F8FAFF"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="buttonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.018" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetName="buttonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.018" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="buttonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetName="buttonSurface" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonSurface" Property="Opacity" Value=".82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonSurface" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#687991"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="17,12"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="tabSurface" Background="#F1F4F9" BorderBrush="Transparent"
              BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="tabSurface" Property="Background" Value="#E8EDFF"/>
        <Setter TargetName="tabSurface" Property="BorderBrush" Value="#D5DEFF"/>
        <Setter Property="Foreground" Value="#2948B8"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="tabSurface" Property="Background" Value="#E9EEF7"/>
        <Setter Property="Foreground" Value="#344FC2"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Tile" TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#E2E8F2"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="19"/>
   <Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="142"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}" RenderTransformOrigin=".5,.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
       <Border.Effect><DropShadowEffect Color="#243A62" BlurRadius="18" ShadowDepth="2" Opacity=".08"/></Border.Effect>
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A9B9E7"/><Setter TargetName="b" Property="Background" Value="#FBFCFF"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="20" Padding="25" Margin="0,0,0,22">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="ניהול שרת NodeBB" FlowDirection="LeftToRight" Foreground="#9DB3D7" FontSize="10" FontWeight="Bold"/>
     <TextBlock Text="מרכז ניהול NodeBB" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,7,0,4"/>
     <TextBlock x:Name="ServerLabel" Foreground="#D0D9E8" FontSize="12"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#284A4C" BorderBrush="#477B73" BorderThickness="1" CornerRadius="13" Padding="14,10" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="#69D4A5" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="החיבור מאובטח" Foreground="#D5F5E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="מרכז הבקרה" FontSize="20" FontWeight="Bold" Foreground="#1E2C43"/><TextBlock Text="ניהול הפורום, תוספים ותחזוקת השרת במקום אחד." Foreground="#77869C" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="הצג טרמינל" Click="ToggleTerminal_Click" Padding="13,8" Margin="0,0,8,0"/>
    <Button Content="עזרה" Click="Help_Click" Padding="13,8"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl x:Name="ManagerTabs" Background="Transparent" BorderThickness="0" SelectionChanged="ManagerTabs_SelectionChanged">
    <TabItem Header="סקירה">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><UniformGrid Columns="3" Margin="0,12,0,0">
      <Button Style="{StaticResource Tile}" Click="List_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="▦" FontSize="26" Foreground="#405CE8"/><TextBlock Text="תוספים" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="צפייה ברשימת התוספים הפעילים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Backup_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="◫" FontSize="26" Foreground="#16865A"/><TextBlock Text="גיבוי מלא" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="גיבוי הפורום ומניפסט התוספים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Status_Click" Margin="0,0,0,10"><StackPanel><TextBlock Text="⌁" FontSize="26" Foreground="#2784A5"/><TextBlock Text="מצב הפורום" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="שירות ותהליכים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Logs_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="≋" FontSize="26" Foreground="#7654C8"/><TextBlock Text="יומני מערכת" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הצגת שורות אחרונות מהלוגים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Build_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="⚒" FontSize="26" Foreground="#B76E12"/><TextBlock Text="בנייה מחדש" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הרצת nodebb build" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Restart_Click" Margin="0,0,0,10"><StackPanel><TextBlock Text="↻" FontSize="26" Foreground="#C34B4B"/><TextBlock Text="הפעלה מחדש" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הפעלה מחדש של nodebb.service" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Zips_Click" Margin="0,0,10,0"><StackPanel><TextBlock Text="▤" FontSize="26" Foreground="#405CE8"/><TextBlock Text="קובצי ZIP בשרת" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הצגת קבצים שהועלו" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
     </UniformGrid></ScrollViewer>
    </TabItem>
    <TabItem Header="ניהול תוספים">
     <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="ספריית התוספים" FontSize="21" FontWeight="Bold" Foreground="#1D2B43"/><TextBlock x:Name="PluginCountText" Text="טען את רשימת התוספים מהשרת" Foreground="#75849A" FontSize="12" Margin="0,4,0,0"/>
        <TextBlock x:Name="PluginActionStatus" Text="בחר תוסף כדי לנהל אותו" Foreground="#4965B8" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
       <Button Grid.Column="1" Content="רענון מהשרת" Click="List_Click" Padding="15,9" VerticalAlignment="Center"/>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,14">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="התקנת תוסף חדש" FontSize="15" FontWeight="Bold" Foreground="#263750"/>
        <Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="InstallSourceBox" SelectedIndex="0" Height="40" Padding="8" SelectionChanged="InstallSourceBox_SelectionChanged"><ComboBoxItem Content="מאגר npm"/><ComboBoxItem Content="קישור GitHub"/><ComboBoxItem Content="קובץ ZIP"/></ComboBox>
         <TextBox x:Name="TargetBox" Grid.Column="1" Height="40" Margin="9,0,0,0" Padding="11" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
         <Button x:Name="UploadZipButton" Grid.Column="2" Content="בחירת ZIP והעלאה" Click="UploadZip_Click" Padding="14,9" Margin="9,0,0,0" Background="#EEF2FF" Foreground="#344FC2" BorderBrush="#D9E1FF" Visibility="Collapsed"/>
         <Button Grid.Column="3" Content="התקנה" Click="Install_Click" Padding="19,9" Margin="9,0,0,0" Background="#3659D9" Foreground="White" BorderThickness="0"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="קובץ ZIP מועלה ישירות לשרת (עד 25MB). לאחר ההעלאה אפשר להתקין אותו מכאן." Foreground="#7C8AA0" FontSize="11" Margin="0,8,0,0"/>
       </Grid>
      </Border>
      <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PluginSearchBox" Height="38" Padding="12" VerticalContentAlignment="Center" FontSize="12" ToolTip="חיפוש לפי שם חבילה" TextChanged="PluginSearchBox_TextChanged"/>
        <ComboBox x:Name="PluginKindFilter" Grid.Column="1" Height="38" Margin="9,0,0,0" Padding="8" SelectedIndex="0" SelectionChanged="PluginKindFilter_SelectionChanged">
         <ComboBoxItem Content="כל הסוגים"/><ComboBoxItem Content="תוספים בלבד"/><ComboBoxItem Content="ערכות עיצוב בלבד"/>
        </ComboBox>
        <Button Grid.Column="2" Content="העתקת הרשימה" Click="CopyPluginList_Click" Padding="11,8" Margin="9,0,0,0"/>
        <Button Grid.Column="3" Content="ייצוא TXT" Click="ExportPluginList_Click" Padding="11,8" Margin="7,0,0,0"/>
       </Grid>
       <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#DCE4FF" BorderThickness="1" CornerRadius="13" Padding="10,8" Margin="0,0,0,11">
        <DockPanel LastChildFill="False">
         <TextBlock x:Name="PluginSelectionCount" Text="לא נבחרו פריטים" Foreground="#40558D" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <Button Content="בחירת כל המוצגים" Click="SelectVisiblePlugins_Click" Padding="10,6" Margin="0,0,7,0"/>
         <Button Content="ניקוי בחירה" Click="ClearPluginSelection_Click" Padding="10,6" Margin="0,0,7,0"/>
         <Button Content="עדכון נבחרים" Click="BulkUpdate_Click" Padding="10,6" Margin="0,0,7,0" Background="#3659D9" Foreground="White" BorderThickness="0"/>
         <Button Content="השבתת נבחרים" Click="BulkDisable_Click" Padding="10,6" Margin="0,0,7,0"/>
         <Button Content="הסרת נבחרים" Click="BulkRemove_Click" Padding="10,6" Foreground="#B42318"/>
        </DockPanel>
       </Border>
       <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl x:Name="PluginCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="286" ItemHeight="206"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,13,13">
            <Border.Effect><DropShadowEffect Color="#203451" BlurRadius="16" ShadowDepth="2" Opacity=".07"/></Border.Effect>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="בחירת התוסף לפעולה מרובה"/>
              <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="10" Width="38" Height="38" HorizontalAlignment="Left"><TextBlock Text="✦" Foreground="#4A63C8" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <Border Grid.Column="2" Background="#E8F7EF" CornerRadius="10" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="פעיל" Foreground="#18794E" FontSize="10" FontWeight="Bold"/></Border>
             </Grid>
             <StackPanel Grid.Row="1" Margin="0,13,0,10"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#24344D" TextWrapping="Wrap" MaxHeight="42"/><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#78879C" Margin="0,5,0,0"/><TextBlock Text="מותקן וזמין בפורום" FontSize="11" Foreground="#9AA5B5" Margin="0,7,0,0"/></StackPanel>
             <UniformGrid Grid.Row="2" Columns="4"><Button Content="העתקת שם" Tag="{Binding Name}" Click="PluginCopy_Click" Padding="5,7" Margin="0,0,5,0" FontSize="10"/><Button Content="עדכון" Tag="{Binding Name}" Click="PluginUpdate_Click" Padding="7,7" Margin="0,0,5,0" FontSize="10"/><Button Content="השבתה" Tag="{Binding Name}" Click="PluginDisable_Click" Padding="7,7" Margin="0,0,5,0" FontSize="10"/><Button Content="הסרה" Tag="{Binding Name}" Click="PluginRemove_Click" Padding="7,7" FontSize="10" Foreground="#B42318"/></UniformGrid>
            </Grid>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
        <Border x:Name="PluginEmptyState" Background="#F8FAFD" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="16" Padding="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Visible">
         <StackPanel HorizontalAlignment="Center"><TextBlock Text="▦" FontSize="32" Foreground="#A3B1C7" HorizontalAlignment="Center"/><TextBlock x:Name="PluginEmptyTitle" Text="עדיין לא נטענה רשימת התוספים" FontSize="15" FontWeight="Bold" Foreground="#4B5B72" HorizontalAlignment="Center" Margin="0,9,0,4"/><TextBlock x:Name="PluginEmptyDescription" Text="לחץ על «רענון מהשרת» כדי להציג את התוספים ככרטיסים." FontSize="11" Foreground="#8794A8" HorizontalAlignment="Center"/></StackPanel>
        </Border>
       </Grid>
      </Grid>
     </Grid>
    </TabItem>
    <TabItem Header="פעולות והיסטוריה">
     <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,12">
       <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="סיכום הפעולה האחרונה" FontSize="18" FontWeight="Bold" Foreground="#1D2B43"/><TextBlock x:Name="SummaryTitle" Text="מוכן לניהול" FontSize="15" FontWeight="SemiBold" Foreground="#3659D9" Margin="0,12,0,4"/></StackPanel></Grid>
        <TextBlock x:Name="SummaryText" Text="בחר פעולה במרכז הבקרה או במסך התוספים. התוצאות יוצגו כאן בעברית ברורה." FontSize="13" Foreground="#56667D" TextWrapping="Wrap" LineHeight="23"/>
        <Border Background="#F4F7FC" CornerRadius="12" Padding="12" Margin="0,14,0,0"><TextBlock Text="הפלט המקורי והפקודות הטכניות נשמרים בנפרד. להצגתם לחץ על «הצג טרמינל»." Foreground="#687991" FontSize="11" TextWrapping="Wrap"/></Border>
       </StackPanel>
      </Border>
      <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="16" Padding="17">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="היסטוריית פעולות בשרת הזה" FontSize="16" FontWeight="Bold" Foreground="#1D2B43"/><TextBlock x:Name="HistoryCountText" Text="עדיין לא נשמרו פעולות" FontSize="11" Foreground="#78879C" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="HistoryFilterBox" Grid.Column="1" Width="125" Height="34" Margin="8,0" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="HistoryFilterBox_SelectionChanged"><ComboBoxItem Content="כל הפעולות"/><ComboBoxItem Content="הצלחות בלבד"/><ComboBoxItem Content="כישלונות בלבד"/></ComboBox><Button Grid.Column="2" Content="ייצוא CSV" Click="ExportHistory_Click" Margin="0,0,8,0" Padding="11,7"/><Button Grid.Column="3" Content="מחיקת היסטוריה" Click="ClearHistory_Click" Foreground="#B42318" Padding="11,7"/></Grid>
        <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HistoryItems"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="#F8FAFD" BorderBrush="#E6EBF3" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Timestamp}" Foreground="#78879C" FontSize="10" VerticalAlignment="Top"/>
           <StackPanel Grid.Column="1"><TextBlock Text="{Binding Action}" Foreground="#26364F" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding Target}" Foreground="#687991" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="#7B8799" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
           <TextBlock Grid.Column="2" Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="Bold" Margin="10,0,0,0"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
         <Border x:Name="HistoryEmptyState" Background="#F8FAFD" BorderBrush="#E6EBF3" BorderThickness="1" CornerRadius="12" Padding="25" HorizontalAlignment="Stretch" VerticalAlignment="Center"><TextBlock Text="כאן תופיע היסטוריית הפעולות המקומית. היא נשמרת במחשב ואינה נשלחת לשרת." Foreground="#78879C" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/></Border>
        </Grid>
       </Grid>
      </Border>
     </Grid>
    </TabItem>
   </TabControl>
   <Border x:Name="TerminalPanel" Grid.Row="1" Background="#101828" CornerRadius="12" Padding="12" Margin="0,12,0,0" Visibility="Collapsed" Height="190">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
