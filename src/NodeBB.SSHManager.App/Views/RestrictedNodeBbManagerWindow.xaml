<Window x:Class="NodeBB.SSHManager.Views.RestrictedNodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NodeBB · סביבת ניהול" Width="1180" Height="850" MinWidth="940" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft" FontFamily="Segoe UI">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#17253E" Offset="0"/>
   <GradientStop Color="#243D68" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#26364F"/>
   <Setter Property="BorderBrush" Value="#DCE4F0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="buttonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="buttonSurface" Property="BorderBrush" Value="#9BAFDC"/><Setter TargetName="buttonSurface" Property="Background" Value="#F8FAFF"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonSurface" Property="Opacity" Value=".82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="buttonSurface" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#6D7B91"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="18,11"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="tabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="tabSurface" Property="BorderBrush" Value="#4565D8"/><Setter Property="Foreground" Value="#263F9D"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#344FC2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Tile" TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#E2E8F2"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="19"/>
   <Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="142"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
       <Border.Effect><DropShadowEffect Color="#243A62" BlurRadius="18" ShadowDepth="2" Opacity=".08"/></Border.Effect>
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A9B9E7"/><Setter TargetName="b" Property="Background" Value="#FBFCFF"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="20" Padding="25" Margin="0,0,0,22">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="NODEBB  /  SERVER CONTROL" FlowDirection="LeftToRight" Foreground="#9DB3D7" FontSize="10" FontWeight="Bold"/>
     <TextBlock Text="מרכז ניהול NodeBB" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,7,0,4"/>
     <TextBlock x:Name="ServerLabel" Foreground="#D0D9E8" FontSize="12"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#284A4C" BorderBrush="#477B73" BorderThickness="1" CornerRadius="13" Padding="14,10" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="#69D4A5" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="חיבור מוגבל ומאובטח" Foreground="#D5F5E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="מרכז הבקרה" FontSize="20" FontWeight="Bold" Foreground="#1E2C43"/><TextBlock Text="ניהול הפורום, תוספים ותחזוקת השרת במקום אחד." Foreground="#77869C" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="הצג מסוף" Click="ToggleTerminal_Click" Padding="13,8" Margin="0,0,8,0"/>
    <Button Content="עזרה" Click="Help_Click" Padding="13,8"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TabControl x:Name="ManagerTabs" Background="Transparent" BorderThickness="0" SelectionChanged="ManagerTabs_SelectionChanged">
    <TabItem Header="סקירה">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><UniformGrid Columns="3" Margin="0,12,0,0">
      <Button Style="{StaticResource Tile}" Click="List_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="▦" FontSize="26" Foreground="#405CE8"/><TextBlock Text="תוספים" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="צפייה ברשימת התוספים הפעילים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Backup_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="◫" FontSize="26" Foreground="#16865A"/><TextBlock Text="גיבוי מלא" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="גיבוי הפורום ומניפסט התוספים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Status_Click" Margin="0,0,0,10"><StackPanel><TextBlock Text="⌁" FontSize="26" Foreground="#2784A5"/><TextBlock Text="מצב הפורום" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="שירות ותהליכים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Logs_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="≋" FontSize="26" Foreground="#7654C8"/><TextBlock Text="יומני מערכת" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הצגת שורות אחרונות מהלוגים" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Build_Click" Margin="0,0,10,10"><StackPanel><TextBlock Text="⚒" FontSize="26" Foreground="#B76E12"/><TextBlock Text="בנייה מחדש" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הרצת nodebb build" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Restart_Click" Margin="0,0,0,10"><StackPanel><TextBlock Text="↻" FontSize="26" Foreground="#C34B4B"/><TextBlock Text="הפעלה מחדש" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הפעלה מחדש של nodebb.service" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
      <Button Style="{StaticResource Tile}" Click="Zips_Click" Margin="0,0,10,0"><StackPanel><TextBlock Text="▤" FontSize="26" Foreground="#405CE8"/><TextBlock Text="קובצי ZIP בשרת" FontSize="16" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="הצגת קבצים שהועלו" Foreground="#8994A6" FontSize="11"/></StackPanel></Button>
     </UniformGrid></ScrollViewer>
    </TabItem>
    <TabItem Header="ניהול תוספים">
     <Grid Margin="0,14,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="התקנה, עדכון ותחזוקת תוספים" FontSize="18" FontWeight="Bold" Foreground="#202B40"/><TextBlock Text="בחירת מקור התקנה והזנת שם חבילה או כתובת." Foreground="#8994A6" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       <Button Grid.Column="1" Content="רענן רשימה" Click="List_Click" Padding="13,8"/>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="#E5E9F1" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,14">
       <StackPanel>
        <TextBlock Text="מקור התקנה" FontWeight="SemiBold" Foreground="#344054"/>
        <ComboBox x:Name="InstallSourceBox" SelectedIndex="0" Height="38" Margin="0,8,0,10" Padding="8" SelectionChanged="InstallSourceBox_SelectionChanged">
         <ComboBoxItem Content="npm — חבילה במאגר npm"/>
         <ComboBoxItem Content="GitHub — כתובת HTTPS"/>
         <ComboBoxItem Content="ZIP — קובץ שכבר הועלה לשרת"/>
        </ComboBox>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="TargetBox" Height="40" Padding="11" VerticalContentAlignment="Center" FlowDirection="LeftToRight"/>
         <Button x:Name="UploadZipButton" Grid.Column="1" Content="בחר ZIP והעלה" Click="UploadZip_Click" Padding="15,9" Margin="8,0,0,0" Background="#E9EEFF" Foreground="#344FC2" BorderBrush="#D7DFFF" Visibility="Collapsed"/>
         <Button Grid.Column="2" Content="התקן" Click="Install_Click" Padding="22,9" Margin="8,0,0,0" Background="#405CE8" Foreground="White" BorderThickness="0"/>
        </Grid>
        <TextBlock Text="אפשר להעלות קובץ ZIP ישירות מהמחשב (עד 25MB). לאחר ההעלאה שם הקובץ יופיע בשדה ותוכל להתקין אותו." TextWrapping="Wrap" Foreground="#66758C" FontSize="11" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
      <WrapPanel Grid.Row="2" Margin="0,0,0,10">
       <Button Content="עדכון" Click="Update_Click" Padding="12,7" Margin="0,0,7,0"/>
       <Button Content="הפעלה" Click="Activate_Click" Padding="12,7" Margin="0,0,7,0"/>
       <Button Content="השבתה" Click="Disable_Click" Padding="12,7" Margin="0,0,7,0"/>
       <Button Content="הסרה" Click="Remove_Click" Padding="12,7" Margin="0,0,7,0"/>
       <Button Content="מחיקת ZIP" Click="DeleteZip_Click" Padding="12,7"/>
      </WrapPanel>
     </Grid>
    </TabItem>
    <TabItem Header="תוצאות ופעילות">
     <Border Background="#101828" CornerRadius="14" Padding="16" Margin="0,14,0,0">
      <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" Background="Transparent" Foreground="#E6EDF7" BorderThickness="0"/>
     </Border>
    </TabItem>
   </TabControl>
   <Border x:Name="TerminalPanel" Grid.Row="1" Background="#101828" CornerRadius="12" Padding="12" Margin="0,12,0,0" Visibility="Collapsed" Height="190">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock Text="פלט פעולות השרת" Foreground="#AAB7CA" FontSize="11" FontWeight="SemiBold"/><Button DockPanel.Dock="Left" Content="הסתר" Click="ToggleTerminal_Click" Padding="9,3"/></DockPanel>
     <TextBox x:Name="TerminalOutputBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" FlowDirection="LeftToRight" Background="Transparent" Foreground="#E6EDF7" BorderThickness="0"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="הערה: התוכנה מציגה רק פעולות שהשרת אישר לחשבון זה. אין כאן גישת shell כללית או עקיפת הרשאות." Foreground="#8994A6" FontSize="10" Margin="2,14,2,0"/>
 </Grid>
</Window>