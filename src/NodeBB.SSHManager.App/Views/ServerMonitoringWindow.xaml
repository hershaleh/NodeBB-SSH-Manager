<Window x:Class="NodeBB.SSHManager.Views.ServerMonitoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניטור שרת" Width="900" Height="700" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ניטור מצב השרת" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="ServerLabel" Foreground="#778399" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <Button x:Name="RefreshButton" Content="רענון נתונים" Click="Refresh_Click" Padding="16,9" Background="#4263EB" Foreground="White" BorderThickness="0" Margin="0,0,12,0"/>
            <CheckBox x:Name="AutoRefreshCheckBox" Content="רענון אוטומטי" VerticalAlignment="Center" Checked="AutoRefresh_Checked" Unchecked="AutoRefresh_Unchecked" Margin="0,0,8,0"/>
            <ComboBox x:Name="AutoRefreshIntervalComboBox" Width="105" Height="30" VerticalContentAlignment="Center" SelectionChanged="AutoRefreshInterval_SelectionChanged" Margin="0,0,12,0">
                <ComboBoxItem Content="30 שניות" Tag="30"/>
                <ComboBoxItem Content="דקה" Tag="60"/>
                <ComboBoxItem Content="5 דקות" Tag="300"/>
            </ComboBox>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="זמן פעילות" Foreground="#778399"/>
                        <TextBlock x:Name="UptimeText" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel><TextBlock Text="עומס מערכת" Foreground="#778399"/><TextBlock x:Name="LoadText" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel><TextBlock Text="זיכרון" Foreground="#778399"/><TextBlock x:Name="MemoryText" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" Text="—"/></StackPanel>
                    </Border>
                </Grid>
                <Border Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="נפח דיסקים" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="DiskText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#43516A"/></StackPanel>
                </Border>
                <Border Background="#101827" CornerRadius="12" Padding="18">
                    <StackPanel><TextBlock Text="תהליכים מובילים לפי CPU" Foreground="#DCE7F8" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="ProcessesText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#C7F7D4" FontFamily="Consolas" FontSize="12"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" x:Name="CollectedAtText" Foreground="#778399" Margin="0,12,0,0"/>
    </Grid>
</Window>
