<Window x:Class="NodeBB.SSHManager.Views.ServerMonitoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_8346d9ce}" Width="1080" Height="850" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E9F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>
    <Grid Margin="27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="20" Padding="23" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Ui_Live_Server_Telemetry}" Foreground="#AFC0DD" FontSize="9" FontWeight="Bold" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{loc:Tr View_139e44fc}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ServerLabel" Foreground="#C5D1E2" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:Tr View_76dfe72}" Foreground="#91A4C1" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="52" Height="52" Background="#2A3C5B" CornerRadius="15">
                    <TextBlock Text="⌁" FontSize="32" Foreground="#B9C5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="{loc:Tr View_bad0cf85}" Click="Refresh_Click" Padding="16,10" Background="#5268E8" Foreground="White" BorderBrush="#5268E8" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <Border Grid.Column="1" Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,0,9,0">
                <CheckBox x:Name="AutoRefreshCheckBox" Content="{loc:Tr View_c17363a8}" VerticalAlignment="Center" Checked="AutoRefresh_Checked" Unchecked="AutoRefresh_Unchecked" FontSize="10"/>
            </Border>
            <ComboBox x:Name="AutoRefreshIntervalComboBox" Grid.Column="2" Width="118" Height="39" VerticalContentAlignment="Center" SelectionChanged="AutoRefreshInterval_SelectionChanged" Margin="0,0,10,0">
                <ComboBoxItem Content="{loc:Tr View_c3e65131}" Tag="30"/>
                <ComboBoxItem Content="{loc:Tr View_b2fdba11}" Tag="60"/>
                <ComboBoxItem Content="{loc:Tr View_30056d35}" Tag="300"/>
            </ComboBox>
            <Border Grid.Column="3" Background="#E8EEF8" CornerRadius="11" Padding="12,9">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#42536D" FontSize="10"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel>
                <TextBlock Text="{loc:Tr View_69bc7b33}" FontSize="16" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,11"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr View_7db6e6c6}" Foreground="#718096" FontSize="10"/>
                            <TextBlock x:Name="UptimeText" FontSize="21" FontWeight="Bold" Foreground="#24334C" Margin="0,9,0,0" Text="—" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr View_4f3f185c}" Foreground="#9AA6B8" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr View_bbaacf20}" Foreground="#718096" FontSize="10"/>
                            <TextBlock x:Name="LoadText" FontSize="21" FontWeight="Bold" Foreground="#5268E8" Margin="0,9,0,0" Text="—" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr View_bebfeb4d}" Foreground="#9AA6B8" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr View_498ca8ef}" Foreground="#718096" FontSize="10"/>
                            <TextBlock x:Name="MemoryText" FontSize="21" FontWeight="Bold" Foreground="#17865D" Margin="0,9,0,0" Text="—" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr View_4ecafa8}" Foreground="#9AA6B8" FontSize="10" Margin="0,6,0,0"/>
                            <TextBlock Text="{loc:Tr Monitor_SwapLabel}" Foreground="#718096" FontSize="10" Margin="0,12,0,0"/>
                            <TextBlock x:Name="SwapText" FontSize="13" FontWeight="SemiBold" Foreground="#17865D" Margin="0,4,0,0" Text="—" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Monitor_CpuUsageLabel}" Foreground="#718096" FontSize="10"/>
                            <TextBlock x:Name="CpuText" FontSize="21" FontWeight="Bold" Foreground="#5268E8" Margin="0,9,0,0" Text="—" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr Monitor_CpuUsageHint}" Foreground="#9AA6B8" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_c9377bce}" FontSize="15" FontWeight="Bold" Foreground="#23324A"/>
                        <TextBlock x:Name="DiskText" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#43516A" FontSize="12" LineHeight="19"/>
                        <TextBlock Text="{loc:Tr Monitor_InodesLabel}" Foreground="#718096" FontSize="10" Margin="0,12,0,0"/>
                        <TextBlock x:Name="DiskInodesText" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#43516A" FontSize="12" LineHeight="19"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Monitor_NetworkLabel}" FontSize="15" FontWeight="Bold" Foreground="#23324A"/>
                        <TextBlock Text="{loc:Tr Monitor_NetworkHint}" Foreground="#9AA6B8" FontSize="10" Margin="0,4,0,0"/>
                        <TextBlock x:Name="NetworkText" Text="—" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#43516A" FontSize="13" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Monitor_TrendTitle}" FontSize="15" FontWeight="Bold" Foreground="#23324A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
                            <TextBlock Text="●" Foreground="#5268E8" Margin="0,0,5,0"/>
                            <TextBlock Text="{loc:Tr Monitor_TrendCpu}" Foreground="#5268E8" FontSize="10" Margin="0,0,14,0"/>
                            <TextBlock Text="●" Foreground="#17865D" Margin="0,0,5,0"/>
                            <TextBlock Text="{loc:Tr Monitor_TrendMemory}" Foreground="#17865D" FontSize="10"/>
                        </StackPanel>
                        <Canvas x:Name="TrendCanvas" Height="112" ClipToBounds="True"/>
                    </StackPanel>
                </Border>
                <Border x:Name="HealthPanel" Background="#FFF8E8" BorderBrush="#F1D69B" BorderThickness="1" CornerRadius="17" Padding="18" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_5b0734a8}" FontWeight="Bold" FontSize="15" Foreground="#85540D"/>
                        <TextBlock x:Name="HealthAlertsText" TextWrapping="Wrap" Margin="0,9,0,0" Foreground="#76531B" FontSize="12" LineHeight="19"/>
                    </StackPanel>
                </Border>
                <Border Background="#101827" CornerRadius="17" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_d5900c65}" Foreground="#E5ECF8" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{loc:Tr View_af989d80}" Foreground="#8395B2" FontSize="10" Margin="0,4,0,10"/>
                        <TextBlock x:Name="ProcessesText" TextWrapping="Wrap" Foreground="#C7F7D4" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"/>
                    </StackPanel>
                </Border>
                <Border Background="#101827" CornerRadius="17" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Monitor_MemoryProcessesTitle}" Foreground="#E5ECF8" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{loc:Tr Monitor_MemoryProcessesHint}" Foreground="#8395B2" FontSize="10" Margin="0,4,0,10"/>
                        <TextBlock x:Name="MemoryProcessesText" TextWrapping="Wrap" Foreground="#C7F7D4" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" x:Name="CollectedAtText" Foreground="#7C899D" FontSize="10" Margin="3,12,3,0"/>
    </Grid>
</Window>