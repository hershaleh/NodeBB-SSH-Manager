<Window x:Class="NodeBB.SSHManager.Views.ScheduledBackupOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול גיבויים מתוזמנים" Width="1480" Height="850" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="ניהול גיבויים מתוזמנים" FontSize="24" FontWeight="Bold" Foreground="#18243A"/>
                <TextBlock x:Name="SubtitleText" Text="כל התזמונים המקומיים של כל שרתי NodeBB, כולל מצב הריצה והיעד"
                           Foreground="#718096" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="ייצוא CSV" Click="Export_Click" Padding="15,9" Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton" Content="הסרת תזמון נבחר" Click="Remove_Click" Padding="15,9" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Content="רענון" Click="Refresh_Click" Padding="15,9"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TotalLabel" Text="תזמונים" Foreground="#718096"/><TextBlock x:Name="TotalCount" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="HealthyLabel" Text="ללא התראות" Foreground="#718096"/><TextBlock x:Name="HealthyCount" FontSize="25" FontWeight="Bold" Foreground="#16865D"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="AttentionLabel" Text="דורשים בדיקה" Foreground="#718096"/><TextBlock x:Name="AttentionCount" FontSize="25" FontWeight="Bold" Foreground="#B7791F"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock x:Name="DatabaseLabel" Text="כוללים מסד נתונים" Foreground="#718096"/><TextBlock x:Name="DatabaseCount" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        </UniformGrid>
        <DataGrid x:Name="SchedulesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                  RowBackground="White" AlternatingRowBackground="#F8FAFD" BorderBrush="#E3E9F1"
                  BorderThickness="1" SelectionMode="Single" FlowDirection="RightToLeft" FontSize="12"
                  SelectionChanged="SchedulesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="שרת" Binding="{Binding ServerName}" Width="1.1*"/>
                <DataGridTextColumn Header="כתובת" Binding="{Binding Endpoint}" Width="1*"/>
                <DataGridTextColumn Header="התקנת NodeBB" Binding="{Binding InstallationPath}" Width="1.3*"/>
                <DataGridTextColumn Header="סוג גיבוי" Binding="{Binding BackupType}" Width="1.2*"/>
                <DataGridTextColumn Header="תדירות" Binding="{Binding Cadence}" Width="1*"/>
                <DataGridTextColumn Header="הגיבוי הבא" Binding="{Binding NextRunLocal}" Width="1*"/>
                <DataGridTextColumn Header="ריצה אחרונה" Binding="{Binding LastRunLocal}" Width="1*"/>
                <DataGridTextColumn Header="תוצאה" Binding="{Binding LastResult}" Width="1.1*"/>
                <DataGridTextColumn Header="שמירה" Binding="{Binding Retention}" Width="0.9*"/>
                <DataGridTextColumn Header="תיקיית יעד" Binding="{Binding Destination}" Width="1.8*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="#718096" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="ScopeText" DockPanel.Dock="Left" Foreground="#9A6B25" FontSize="11"
                       Text="התזמונים פועלים תחת משתמש Windows הנוכחי ורק כשהוא מחובר."/>
        </DockPanel>
    </Grid>
</Window>