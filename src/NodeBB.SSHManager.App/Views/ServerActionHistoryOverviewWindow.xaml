<Window x:Class="NodeBB.SSHManager.Views.ServerActionHistoryOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="היסטוריית פעולות — כל השרתים" Width="1050" Height="720"
        MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F2F5FB" FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#172944" CornerRadius="18" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="מרכז פעילות" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="היסטוריית פעולות מקומית מכל שרתי NodeBB השמורים במחשב" Foreground="#C7D3E8" FontSize="12" Margin="0,5,0,0"/>
                <TextBlock x:Name="CountText" Text="טוען פעולות..." Foreground="#D8E2F1" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="39" Padding="12,8" FontSize="12" VerticalContentAlignment="Center"
                     Background="White" BorderBrush="#DDE5F0" TextChanged="SearchBox_TextChanged"
                     ToolTip="חיפוש לפי שרת, כתובת, פעולה או יעד"/>
            <ComboBox x:Name="FilterBox" Grid.Column="1" Height="39" Margin="8,0" SelectedIndex="0"
                      SelectionChanged="FilterBox_SelectionChanged">
                <ComboBoxItem Content="כל התוצאות"/>
                <ComboBoxItem Content="הצלחות בלבד"/>
                <ComboBoxItem Content="כישלונות בלבד"/>
            </ComboBox>
            <Button Grid.Column="2" Content="ייצוא התוצאות ל־CSV" Padding="15,8" Click="Export_Click"
                    Background="#4968E8" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E9F2" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFD" BorderBrush="#E6EBF3" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Timestamp}" Foreground="#78879C" FontSize="10" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Server}" Foreground="#26364F" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ActionLine}" Foreground="#52647D" FontSize="11" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="#7B8799" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="Bold" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border x:Name="EmptyState" Background="#F8FAFD" CornerRadius="12" Padding="24" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyText" Text="לא נשמרו עדיין פעולות בשרתים." Foreground="#78879C" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>