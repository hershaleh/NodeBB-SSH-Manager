<Window x:Class="NodeBB.SSHManager.Views.ServerActionHistoryOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_5d3ade50}" Width="1120" Height="800" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="19" Padding="21" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr View_37c96a23}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{loc:Tr View_b1d4d880}" Foreground="#B9C6DA" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock x:Name="CountText" Text="{loc:Tr View_af21744f}" Foreground="#B5C4DA" FontSize="11" Margin="0,11,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="54" Height="54" Background="#293B5C" CornerRadius="15">
                    <TextBlock Text="◷" FontSize="29" Foreground="#B5C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="41" Padding="13,9" FontSize="12" VerticalContentAlignment="Center"
                     Background="White" BorderBrush="#DDE5F0" TextChanged="SearchBox_TextChanged"
                     ToolTip="{loc:Tr View_f4b53f5a}"/>
            <ComboBox x:Name="FilterBox" Grid.Column="1" Height="41" Margin="9,0" SelectedIndex="0"
                      SelectionChanged="FilterBox_SelectionChanged" VerticalContentAlignment="Center">
                <ComboBoxItem Content="{loc:Tr View_4cd9ae96}"/>
                <ComboBoxItem Content="הצלחות בלבד"/>
                <ComboBoxItem Content="כישלונות בלבד"/>
            </ComboBox>
            <Button Grid.Column="2" Content="{loc:Tr View_4891f52f}" Padding="17,9" Click="Export_Click"
                    Background="#4F63D9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="5,2,5,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr View_e7f1660b}" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{loc:Tr View_5379002e}" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="{loc:Tr View_6ee8633e}" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFD" BorderBrush="#E6EBF3" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="#78879C" FontSize="10" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Server}" Foreground="#26364F" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ActionLine}" Foreground="#52647D" FontSize="11" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="#7B8799" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#EDF2F8" CornerRadius="8" Padding="9,5" VerticalAlignment="Top" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="EmptyState" Background="#F8FAFD" CornerRadius="12" Padding="24" VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyText" Text="{loc:Tr View_a4899a1}" Foreground="#78879C" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>