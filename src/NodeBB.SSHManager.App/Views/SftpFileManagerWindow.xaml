<Window x:Class="NodeBB.SSHManager.Views.SftpFileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_e066c31c}" Width="1120" Height="760" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style x:Key="FileAction" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#34445D"/><Setter Property="BorderBrush" Value="#DFE6F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EDF1F6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F5FF"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8EDFF"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="19" Padding="21" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr View_f8ee7b26}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="ServerLabel" Foreground="#B9C6DA" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock Text="{loc:Tr View_4a3849a}" Foreground="#8FA3C1" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="54" Height="54" Background="#293B5C" CornerRadius="15">
                    <TextBlock Text="▤" FontSize="28" Foreground="#B5C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Height="39" Padding="12,8" VerticalContentAlignment="Center"
                         FlowDirection="LeftToRight" ToolTip="{loc:Tr View_9b90297d}" Background="#F7F9FC" BorderBrush="#E2E8F0"/>
                <Button Grid.Column="1" Content="{loc:Tr View_53c22a09}" Click="Navigate_Click" Margin="9,0,0,0" Padding="17,8"
                        Background="#4F63D9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="{loc:Tr View_a7c2fbfd}" Click="Up_Click" Margin="8,0,0,0" Style="{StaticResource FileAction}"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="5,3,5,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="125"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr View_ecf22cfa}" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{loc:Tr View_e1f7d20b}" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="{loc:Tr View_6540bd4f}" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="{loc:Tr View_a78f268c}" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                </Grid>
                <ListView x:Name="FilesList" Grid.Row="1" MouseDoubleClick="FilesList_MouseDoubleClick"
                          BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Tr View_a29008db}" Width="520" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{loc:Tr View_e1f7d20b}" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                            <GridViewColumn Header="{loc:Tr View_6540bd4f}" Width="120" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            <GridViewColumn Header="{loc:Tr View_3f4c991b}" Width="180" DisplayMemberBinding="{Binding ModifiedDisplay}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel>
                <Button Content="{loc:Tr View_fa2a90a1}" Click="CreateDirectory_Click" Style="{StaticResource FileAction}" Margin="0,0,7,0"/>
                <Button Content="{loc:Tr View_70f4b78f}" Click="Rename_Click" Style="{StaticResource FileAction}" Margin="0,0,7,0"/>
                <Button Content="{loc:Tr View_98d6a00a}" Click="Upload_Click" Style="{StaticResource FileAction}" Margin="0,0,7,0"/>
                <Button Content="{loc:Tr View_2022344c}" Click="Download_Click" Style="{StaticResource FileAction}" Margin="0,0,7,0"/>
                <Button Content="{loc:Tr View_2c407cd2}" Click="Delete_Click" Padding="14,9" Background="#FFF1F1" Foreground="#B42318" BorderBrush="#F3D0D0" BorderThickness="1"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="#64748B" VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"/>
                <Button Content="{loc:Tr View_2baed7c0}" Click="Refresh_Click" Style="{StaticResource FileAction}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>