<Window x:Class="NodeBB.SSHManager.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אבחון ויומני פעילות" Width="720" Height="520" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="אבחון ויומני פעילות" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock Text="כלי לאיסוף מידע שיסייע באיתור ובתיקון תקלות." Foreground="#778399" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,18,0,18">
            <StackPanel>
                <TextBlock Text="מה ייכלל בדוח?" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="• יומן אירועים ושגיאות של התוכנה&#10;• תאריך ושעה, רכיב, פעולה ופרטי חריגה&#10;• גרסת התוכנה, Windows ו-.NET&#10;• שגיאות חוזרות והפעולות שקדמו להן" Margin="0,12,0,16" Foreground="#43516A" LineHeight="24"/>
                <Border Background="#EAF7EF" CornerRadius="8" Padding="12">
                    <TextBlock Text="פרטיות: הדוח אינו כולל סיסמאות, מפתחות פרטיים, פרופילי שרתים או תוכן קבצים מרוחקים. מידע רגיש עובר הסתרה לפני הייצוא. הדוח נשמר אצלך בלבד; אין שליחה אוטומטית." TextWrapping="Wrap" Foreground="#17633B"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="מוכן לייצוא." Foreground="#778399" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ייצוא דוח אבחון ZIP" Click="Export_Click" Padding="18,10" Background="#4263EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="סגור" Click="Close_Click" Padding="18,10" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
