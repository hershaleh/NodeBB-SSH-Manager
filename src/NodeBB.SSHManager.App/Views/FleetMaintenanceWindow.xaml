<Window x:Class="NodeBB.SSHManager.Views.FleetMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מרכז תחזוקת NodeBB" Width="1550" Height="850" MinWidth="1120" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="מרכז תחזוקת NodeBB" FontSize="24" FontWeight="Bold" Foreground="#18243A"/>
                <TextBlock x:Name="SubtitleText" Text="איתור התקנות ובדיקת תנאים מקדימים לשדרוג בכל השרתים המחוברים באמצעות SSH מאומת."
                           Foreground="#718096" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="ייצוא CSV" Click="Export_Click" Padding="15,9" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="סרוק התקנות" Click="Refresh_Click" Padding="15,9"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TotalLabel" Text="התקנות" Foreground="#718096"/><TextBlock x:Name="TotalCount" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="ReadyLabel" Text="מוכנות לאחר גיבוי" Foreground="#718096"/><TextBlock x:Name="ReadyCount" FontSize="25" FontWeight="Bold" Foreground="#16865D"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="BlockedLabel" Text="דורשות טיפול" Foreground="#718096"/><TextBlock x:Name="BlockedCount" FontSize="25" FontWeight="Bold" Foreground="#B7791F"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock x:Name="OfflineLabel" Text="לא זמינות" Foreground="#718096"/><TextBlock x:Name="OfflineCount" FontSize="25" FontWeight="Bold" Foreground="#C05656"/></StackPanel></Border>
        </UniformGrid>
        <DataGrid x:Name="MaintenanceGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                  RowBackground="White" AlternatingRowBackground="#F8FAFD" BorderBrush="#E3E9F1"
                  BorderThickness="1" SelectionMode="Single" SelectionChanged="MaintenanceGrid_SelectionChanged"
                  FlowDirection="RightToLeft" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ServerColumn" Header="שרת" Binding="{Binding ServerName}" Width="1*"/>
                <DataGridTextColumn x:Name="EndpointColumn" Header="כתובת" Binding="{Binding Endpoint}" Width="1.1*"/>
                <DataGridTextColumn x:Name="PathColumn" Header="נתיב התקנה" Binding="{Binding InstallationPath}" Width="1.8*"/>
                <DataGridTextColumn x:Name="VersionColumn" Header="NodeBB" Binding="{Binding Version}" Width="0.7*"/>
                <DataGridTextColumn x:Name="BranchColumn" Header="ענף" Binding="{Binding Branch}" Width="0.8*"/>
                <DataGridTextColumn x:Name="DatabaseColumn" Header="מסד נתונים" Binding="{Binding DatabaseType}" Width="0.8*"/>
                <DataGridTextColumn x:Name="NodeColumn" Header="Node.js" Binding="{Binding NodeVersion}" Width="0.8*"/>
                <DataGridTextColumn x:Name="NpmColumn" Header="npm" Binding="{Binding NpmVersion}" Width="0.8*"/>
                <DataGridTextColumn x:Name="StatusColumn" Header="מצב" Binding="{Binding Status}" Width="1.1*"/>
                <DataGridTextColumn x:Name="FindingsColumn" Header="ממצאים" Binding="{Binding Findings}" Width="2.3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="הבדיקה לקריאה בלבד; אין התחברות או שדרוג אוטומטיים." Foreground="#718096" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="OpenUpgradeButton" Grid.Column="1" Content="פתח אשף שדרוג" Click="OpenUpgrade_Click"
                    IsEnabled="False" Padding="16,9" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock x:Name="SafetyText" Grid.Row="3" Visibility="Collapsed"/>
    </Grid>
</Window>
