<Window x:Class="NodeBB.SSHManager.Views.ServerComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="השוואת שרתים" Width="1120" Height="680" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F2F5FB" FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="השוואת שרתים מחוברים" FontSize="25" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock Text="השוואה מקבילה של פרטי מערכת וגרסאות תוכנה. לא מתבצעים שינויים בשרתים." Foreground="#778399" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <Button x:Name="RefreshButton" Content="רענון השוואה" Click="Refresh_Click" Padding="16,9" Background="#4263EB" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#778399" Margin="12,0,0,0"/>
        </DockPanel>
        <DataGrid x:Name="ComparisonGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserResizeRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="White" BorderBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F7F9FD"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="שרת" Binding="{Binding Server}" MinWidth="125"/>
                <DataGridTextColumn Header="כתובת" Binding="{Binding Host}" MinWidth="145"/>
                <DataGridTextColumn Header="מערכת הפעלה" Binding="{Binding OperatingSystem}" MinWidth="170"/>
                <DataGridTextColumn Header="ליבה" Binding="{Binding Kernel}" MinWidth="120"/>
                <DataGridTextColumn Header="ארכיטקטורה" Binding="{Binding Architecture}" MinWidth="100"/>
                <DataGridTextColumn Header="Node.js" Binding="{Binding Node}" MinWidth="95"/>
                <DataGridTextColumn Header="npm" Binding="{Binding Npm}" MinWidth="85"/>
                <DataGridTextColumn Header="Git" Binding="{Binding Git}" MinWidth="85"/>
                <DataGridTextColumn Header="MongoDB" Binding="{Binding Mongo}" MinWidth="105"/>
                <DataGridTextColumn Header="Redis" Binding="{Binding Redis}" MinWidth="95"/>
                <DataGridTextColumn Header="Docker" Binding="{Binding Docker}" MinWidth="95"/>
                <DataGridTextColumn Header="תוצאה" Binding="{Binding Status}" MinWidth="170"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="שרתים בחשבון SSH מוגבל שאינו מספק מעטפת Linux רגילה יסומנו כלא נתמכים בהשוואת המערכת."
                   Foreground="#7A879A" FontSize="11" Margin="0,12,0,0"/>
    </Grid>
</Window>