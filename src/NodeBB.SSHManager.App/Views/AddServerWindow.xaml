<Window x:Class="NodeBB.SSHManager.Views.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_7b27caba}" Width="650" Height="790" MinWidth="580" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FlowDirection="RightToLeft" Background="#F3F6FC" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="{loc:Tr View_4986861e}" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{loc:Tr View_b7fa1e4e}" Foreground="#B9C6DA" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock Text="{loc:Tr View_48cd3954}" Foreground="#8FA3C1" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="50" Height="50" Background="#293B5C" CornerRadius="14">
                    <TextBlock Text="⌘" FontSize="26" Foreground="#B5C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,17,0,16" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="{loc:Tr View_c602cc93}" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_9d668988}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="NameBox" Padding="10" Height="40" Margin="0,6,0,13"/>
                        <TextBlock Text="{loc:Tr View_26b55ee6}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="GroupBox" Padding="10" Height="40" Margin="0,6,0,0" ToolTip="{loc:Tr View_4e8343b2}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Tr View_59db7204}" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_be23c9f5}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="HostBox" Padding="10" Height="40" Margin="0,6,0,13" FlowDirection="LeftToRight"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr View_68c96b34}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="PortBox" Text="22" Padding="10" Height="40" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr View_22223bc1}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="UsernameBox" Padding="10" Height="40" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Tr View_338c25a1}" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_7c1fb1c9}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox x:Name="AuthTypeBox" SelectedIndex="0" Padding="9" Height="40" Margin="0,6,0,13">
                            <ComboBoxItem Content="{loc:Tr View_96f6490a}" Tag="PrivateKey"/>
                            <ComboBoxItem Content="{loc:Tr View_c70acef8}" Tag="Password"/>
                        </ComboBox>
                        <TextBlock Text="{loc:Tr View_1bf5e8e7}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyPathBox" Padding="10" Height="40" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="1" Content="{loc:Tr View_5d796ef6}" Click="BrowseKey_Click" Padding="15,8" Margin="8,0,0,0"/>
                        </Grid>
                        <Border Background="#FFF5E8" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                            <TextBlock Text="{loc:Tr View_55e03a1}" Foreground="#8A5A1B" FontSize="10" TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="{loc:Tr View_7765c0d0}" IsDefault="True" Click="Save_Click" Background="#4F63D9" Foreground="White" BorderThickness="0" Padding="20,11" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <Button Content="{loc:Tr View_5b36e7e4}" IsCancel="True" Padding="19,11"/>
        </StackPanel>
    </Grid>
</Window>