<Window x:Class="NodeBB.SSHManager.Views.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הוספת שרת" Width="650" Height="790" MinWidth="580" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FlowDirection="RightToLeft" Background="#F3F6FC" FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="הוספת שרת NodeBB" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="יצירת פרופיל חיבור SSH מאובטח" Foreground="#B9C6DA" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock Text="סודות אינם נשמרים בפרופיל השרת" Foreground="#8FA3C1" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="50" Height="50" Background="#293B5C" CornerRadius="14">
                    <TextBlock Text="⌘" FontSize="26" Foreground="#B5C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,17,0,16" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="זיהוי השרת" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="שם לזיהוי" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="NameBox" Padding="10" Height="40" Margin="0,6,0,13"/>
                        <TextBlock Text="קבוצה (לא חובה)" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="GroupBox" Padding="10" Height="40" Margin="0,6,0,0" ToolTip="למשל: ייצור, בדיקות, לקוחות או פרויקטים"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="פרטי חיבור" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="כתובת שרת או IP" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="HostBox" Padding="10" Height="40" Margin="0,6,0,13" FlowDirection="LeftToRight"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="פורט SSH" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="PortBox" Text="22" Padding="10" Height="40" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="שם משתמש SSH" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBox x:Name="UsernameBox" Padding="10" Height="40" Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="אימות וזהות" FontSize="15" FontWeight="Bold" Foreground="#23324A" Margin="2,0,0,10"/>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="17">
                    <StackPanel>
                        <TextBlock Text="שיטת אימות" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox x:Name="AuthTypeBox" SelectedIndex="0" Padding="9" Height="40" Margin="0,6,0,13">
                            <ComboBoxItem Content="מפתח SSH" Tag="PrivateKey"/>
                            <ComboBoxItem Content="סיסמה" Tag="Password"/>
                        </ComboBox>
                        <TextBlock Text="נתיב לקובץ מפתח פרטי" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyPathBox" Padding="10" Height="40" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="1" Content="בחירת קובץ..." Click="BrowseKey_Click" Padding="15,8" Margin="8,0,0,0"/>
                        </Grid>
                        <Border Background="#FFF5E8" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                            <TextBlock Text="סיסמה או Passphrase יתבקשו בעת בדיקת החיבור ולא יישמרו בקובץ הפרופיל. יש לאמת את טביעת מפתח השרת לפני אמון בחיבור." Foreground="#8A5A1B" FontSize="10" TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="שמור פרופיל שרת" IsDefault="True" Click="Save_Click" Background="#4F63D9" Foreground="White" BorderThickness="0" Padding="20,11" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <Button Content="ביטול" IsCancel="True" Padding="19,11"/>
        </StackPanel>
    </Grid>
</Window>