<Window x:Class="NodeBB.SSHManager.Views.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הוספת שרת" Width="560" Height="610"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#F4F6FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="DialogTitle" Text="הוספת שרת NodeBB" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="הגדר פרופיל חיבור SSH. פרטי סוד לא נשמרים כאן." Foreground="#778399" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,18">
            <StackPanel>
                <TextBlock Text="שם לזיהוי" FontWeight="SemiBold"/>
                <TextBox x:Name="NameBox" Padding="10" Margin="0,6,0,14"/>
                <TextBlock Text="כתובת שרת או IP" FontWeight="SemiBold"/>
                <TextBox x:Name="HostBox" Padding="10" Margin="0,6,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="פורט SSH" FontWeight="SemiBold"/>
                        <TextBox x:Name="PortBox" Text="22" Padding="10" Margin="0,6,0,14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="שם משתמש SSH" FontWeight="SemiBold"/>
                        <TextBox x:Name="UsernameBox" Padding="10" Margin="0,6,0,14"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="שיטת אימות" FontWeight="SemiBold"/>
                <ComboBox x:Name="AuthTypeBox" SelectedIndex="0" Padding="8" Margin="0,6,0,14">
                    <ComboBoxItem Content="מפתח SSH" Tag="PrivateKey"/>
                    <ComboBoxItem Content="סיסמה" Tag="Password"/>
                </ComboBox>
                <TextBlock Text="נתיב לקובץ מפתח פרטי" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="KeyPathBox" Padding="10"/>
                    <Button Grid.Column="1" Content="עיון..." Click="BrowseKey_Click" Padding="14,7" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="הערה: סיסמה או Passphrase יתבקשו בעת בדיקת החיבור ולא יישמרו בקובץ פרופיל השרת." Foreground="#778399" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="שמור שרת" IsDefault="True" Click="Save_Click" Background="#4263EB" Foreground="White" BorderThickness="0" Padding="20,10" Margin="0,0,8,0"/>
            <Button Content="ביטול" IsCancel="True" Padding="18,10"/>
        </StackPanel>
    </Grid>
</Window>
