<Window x:Class="NodeBB.SSHManager.Views.SshTerminalWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="מסוף SSH" Width="900" Height="620" MinWidth="650" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#101827" Foreground="#E6EDF7"
 FlowDirection="LeftToRight">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <TextBlock x:Name="ServerLabel" Text="SSH Terminal" FontSize="15" FontWeight="SemiBold" Foreground="#DCE7F8"/>
   <TextBlock DockPanel.Dock="Right" Text="הקלד פקודות בשורת הקלט" Foreground="#8FA2BD" FontSize="11"/>
  </DockPanel>
  <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
   Background="#0B1220" Foreground="#C7F7D4" BorderBrush="#26364D"
   FontFamily="Consolas" FontSize="13" Padding="12"/>
  <TextBox x:Name="InputBox" Grid.Row="2" Margin="0,10,0,0" Height="40" Padding="10"
   Background="#1B2940" Foreground="White" BorderBrush="#3B5272"
   FontFamily="Consolas" FontSize="13" KeyDown="InputBox_KeyDown"/>
 </Grid>
</Window>
