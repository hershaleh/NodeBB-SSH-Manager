<Window x:Class="NodeBB.SSHManager.Views.SshTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_70ba6176}" Width="960" Height="680" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E6EDF7"
        FlowDirection="LeftToRight" FontFamily="Cascadia Code, Consolas">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" BorderBrush="#293B56" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Ui_Secure_Shell_Session}" Foreground="#91A6C5" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="ServerLabel" Text="{loc:Tr Ui_Ssh_Terminal}" FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF7" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1F493B" BorderBrush="#2C7156" BorderThickness="1" CornerRadius="9" Padding="11,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#69D4A5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SSH" Foreground="#C9F3DE" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#070D17" BorderBrush="#26364D" BorderThickness="1" CornerRadius="12" Padding="13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                    <TextBlock Text="{loc:Tr Ui_Output}" Foreground="#7488A5" FontSize="9" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Right" Text="{loc:Tr Ui_Interactive_Shell}" Foreground="#667A97" FontSize="9"/>
                </DockPanel>
                <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#C7F7D4" BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas" FontSize="12" Padding="3"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#17243B" BorderBrush="#293B56" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="›" Foreground="#7ED9A8" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                <TextBox x:Name="InputBox" Grid.Column="1" Height="39" Padding="9,7"
                         Background="#101A2B" Foreground="#F1F5FB" BorderBrush="#354A68"
                         FontFamily="Cascadia Code, Consolas" FontSize="12"
                         VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>