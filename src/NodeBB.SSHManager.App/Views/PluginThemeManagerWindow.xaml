<Window x:Class="NodeBB.SSHManager.Views.PluginThemeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ניהול תוספים ועיצובים" Width="980" Height="700" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="תוספים ועיצובים" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="InstallationLabel" Foreground="#778399" Margin="0,5,0,0"/>
            <TextBlock Text="התקנה ועדכון עשויים לשנות את קובצי NodeBB. מומלץ לגבות לפני שינוי חבילות." Foreground="#9A5700" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <Button x:Name="RefreshButton" Content="רענון רשימה" Click="Refresh_Click" Padding="14,8"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
        </DockPanel>
        <ListView x:Name="PackagesList" Grid.Row="2" SelectionChanged="PackagesList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="שם חבילה" Width="520" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="גרסה" Width="180" DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn Header="סוג" Width="120" DisplayMemberBinding="{Binding Kind}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Border Grid.Row="3" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="פעולות חבילה" FontWeight="SemiBold" FontSize="15"/>
                <DockPanel Margin="0,10,0,10">
                    <TextBox x:Name="PackageNameBox" Height="36" Padding="9" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             ToolTip="nodebb-plugin-name או nodebb-theme-name"/>
                    <TextBlock Text="שם npm:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </DockPanel>
                <WrapPanel>
                    <Button Content="התקנה" Click="Install_Click" Padding="14,8" Margin="0,0,8,0" Background="#4263EB" Foreground="White" BorderThickness="0"/>
                    <Button Content="עדכון לגרסה האחרונה" Click="Update_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="הפעלה" Click="Activate_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="השבתה" Click="Deactivate_Click" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="הסרה" Click="Remove_Click" Padding="14,8" Background="#FFF0F0" Foreground="#B42318" BorderThickness="0"/>
                </WrapPanel>
                <TextBlock Text="הערה: שינוי חבילות אינו מפעיל בנייה או אתחול אוטומטיים. לאחר התקנה/עדכון/הסרה, בדוק את הפורום ובצע בנייה ואתחול לפי הצורך. השבתת תוסף משתמשת בפקודת NodeBB reset -p." TextWrapping="Wrap" Foreground="#778399" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
