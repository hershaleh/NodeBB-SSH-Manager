<Window x:Class="NodeBB.SSHManager.Views.ServerDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_2462f78a}" Width="980" Height="820" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="20" Padding="23" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Ui_Server_Capability_Scan}" Foreground="#AFC0DD" FontSize="9" FontWeight="Bold" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{loc:Tr View_5449b4ec}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ServerLabel" Foreground="#C5D1E2" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:Tr View_e6390f91}" Foreground="#91A4C1" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="52" Height="52" Background="#2A3C5B" CornerRadius="15">
                    <TextBlock Text="⌕" FontSize="31" Foreground="#B9C5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="{loc:Tr View_7b92a30a}" Click="Refresh_Click" Padding="17,10" Background="#5268E8" Foreground="White" BorderBrush="#5268E8" FontWeight="SemiBold"/>
            <Border Grid.Column="1" Background="#E8F6EF" CornerRadius="11" Padding="13,9" Margin="11,0,0,0">
                <DockPanel>
                    <TextBlock Text="●" Foreground="#16865A" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr View_435fe9d2}" Foreground="#17633B" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Foreground="#42536D" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="18" Padding="17">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="3,0,3,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr View_fc11ae46}" Foreground="#64748B" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Grid.Column="1" Text="{loc:Tr View_d11b5092}" Foreground="#64748B" FontWeight="Bold" FontSize="10"/>
                </Grid>
                <ListView x:Name="CapabilitiesList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EDF0F5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Tr View_fc11ae46}" Width="280" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{loc:Tr View_d11b5092}" Width="560" DisplayMemberBinding="{Binding Value}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="DetectedAtText" Foreground="#7C899D" FontSize="10" Margin="3,12,3,0"/>
    </Grid>
</Window>