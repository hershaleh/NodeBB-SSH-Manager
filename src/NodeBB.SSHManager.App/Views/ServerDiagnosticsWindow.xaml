<Window x:Class="NodeBB.SSHManager.Views.ServerDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אבחון יכולות שרת" Width="820" Height="720" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="מיפוי יכולות השרת" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="ServerLabel" Foreground="#778399" Margin="0,5,0,0"/>
            <TextBlock Text="הבדיקה קוראת מידע בלבד ואינה משנה הגדרות או מפעילה שירותים." Foreground="#17633B" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <Button x:Name="RefreshButton" Content="סריקה מחדש" Click="Refresh_Click" Padding="16,9" Background="#4263EB" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
        </DockPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="12">
            <ListView x:Name="CapabilitiesList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="רכיב / יכולת" Width="230" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="זיהוי / גרסה" Width="500" DisplayMemberBinding="{Binding Value}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="3" x:Name="DetectedAtText" Foreground="#778399" Margin="0,12,0,0"/>
    </Grid>
</Window>
