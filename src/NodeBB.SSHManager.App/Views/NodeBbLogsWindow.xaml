<Window x:Class="NodeBB.SSHManager.Views.NodeBbLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="לוגים של NodeBB" Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#101827" FlowDirection="RightToLeft">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="יומן NodeBB" FontSize="23" FontWeight="Bold" Foreground="#E6EDF7"/>
            <TextBlock x:Name="InstallationLabel" Foreground="#9AAAC0" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,14,0,10">
            <Button x:Name="RefreshButton" Content="רענון" Click="Refresh_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="העתקת תצוגה" Click="Copy_Click" Padding="14,8" Margin="0,0,12,0"/>
            <TextBox x:Name="SearchBox" Width="260" Height="34" Padding="8" VerticalContentAlignment="Center"
                     ToolTip="סינון לפי טקסט" TextChanged="Search_TextChanged"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#9AAAC0"/>
        </DockPanel>
        <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#0B1220" Foreground="#C7F7D4" BorderBrush="#26364D"
                 FontFamily="Consolas" FontSize="12" Padding="12" FlowDirection="LeftToRight"/>
        <TextBlock Grid.Row="3" Text="מוצגות עד 500 השורות האחרונות מקובץ הלוג שהוגדר ב-config.json (ברירת מחדל: logs/output.log)." Foreground="#9AAAC0" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
