<Window x:Class="NodeBB.SSHManager.Views.NodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="מרכז ניהול NodeBB" Width="1120" Height="820" MinWidth="900" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#F3F5FA" FlowDirection="RightToLeft" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="TileButton" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#202B40"/>
   <Setter Property="BorderBrush" Value="#E5E9F1"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="#AABAF2"/><Setter TargetName="tile" Property="Background" Value="#FCFCFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="tile" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="tile" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="#405CE8"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="מרכז ניהול NodeBB" FontSize="26" FontWeight="Bold" Foreground="#182338"/>
    <TextBlock x:Name="ServerLabel" Foreground="#778399" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="מסוף SSH ↗" Click="Terminal_Click" Padding="15,10" Background="#172235" Foreground="White" BorderThickness="0" VerticalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#E5E9F1" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="התקנת NodeBB פעילה" Foreground="#8994A6" FontSize="11"/>
     <TextBlock x:Name="SelectedInstallationText" Text="טרם נבחרה התקנה" Foreground="#202B40" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
    </StackPanel>
    <ComboBox x:Name="InstallationPicker" Grid.Column="1" Width="240" Height="36" Margin="12,0" VerticalContentAlignment="Center"
      SelectionChanged="InstallationPicker_SelectionChanged" DisplayMemberPath="Path"/>
    <Button Grid.Column="2" x:Name="DiscoverButton" Content="סריקה מחדש" Click="Discover_Click" Padding="14,8"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="כלי הניהול" FontSize="20" FontWeight="Bold" Foreground="#182338"/>
    <TextBlock Text="בחר תחום לניהול. פעולות רגישות יבקשו אישור לפני ביצוע." FontSize="12" Foreground="#8994A6" Margin="0,4,0,0"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="#667085" FontSize="11" TextWrapping="Wrap" MaxWidth="360"/>
  </Grid>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
   <UniformGrid Columns="3" Rows="3">
    <Button Style="{StaticResource TileButton}" Click="Packages_Click" Margin="0,0,10,10">
     <StackPanel><Border Background="#EEF1FF" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="▦" FontSize="23" Foreground="#405CE8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="תוספים ועיצובים" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="רשימת חבילות, התקנה, עדכון והפעלה" Foreground="#8994A6" FontSize="11" TextWrapping="Wrap"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Backups_Click" Margin="0,0,10,10">
     <StackPanel><Border Background="#EAF7F0" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="◫" FontSize="23" Foreground="#16865A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="גיבוי ושחזור" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="יצירת גיבויים וניהול שחזור" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Upgrade_Click" Margin="0,0,0,10">
     <StackPanel><Border Background="#FFF4E5" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="↥" FontSize="23" Foreground="#B76E12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="עדכוני NodeBB" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="בדיקת גרסה ושדרוג מבוקר" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Logs_Click" Margin="0,0,10,10">
     <StackPanel><Border Background="#F0EBFF" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="≋" FontSize="23" Foreground="#7654C8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="יומני מערכת" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="איתור שגיאות ומעקב פעילות" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Database_Click" Margin="0,0,10,10">
     <StackPanel><Border Background="#E8F5FA" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="◉" FontSize="23" Foreground="#2784A5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="מסד נתונים" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="כלי מידע וניהול מסד הנתונים" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Security_Click" Margin="0,0,0,10">
     <StackPanel><Border Background="#FFF0F0" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="◇" FontSize="23" Foreground="#C34B4B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="אבטחה וביקורת" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="בדיקות אבטחה והרשאות" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Monitoring_Click" Margin="0,0,10,0">
     <StackPanel><Border Background="#EAF7F0" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="⌁" FontSize="23" Foreground="#16865A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ניטור שרת" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="משאבים, תהליכים ומצב השירות" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Diagnostics_Click" Margin="0,0,10,0">
     <StackPanel><Border Background="#EEF1FF" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="⌕" FontSize="23" Foreground="#405CE8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="אבחון ותקלות" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="בדיקות מערכת וקישוריות" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Services_Click" Margin="0">
     <StackPanel><Border Background="#F1F3F7" CornerRadius="11" Width="42" Height="42" HorizontalAlignment="Right"><TextBlock Text="⚙" FontSize="22" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="שירותי מערכת" FontSize="16" FontWeight="Bold" Margin="0,13,0,5"/><TextBlock Text="ניהול שירותים ותהליכי שרת" Foreground="#8994A6" FontSize="11"/></StackPanel>
    </Button>
   </UniformGrid>
  </ScrollViewer>
  <Border Grid.Row="4" Background="#172235" CornerRadius="13" Padding="14" Margin="0,15,0,0">
   <DockPanel>
    <Button Content="הפעל" Click="Start_Click" Margin="0,0,7,0" Padding="14,7" Background="#254C40" Foreground="White" BorderThickness="0"/>
    <Button Content="עצור" Click="Stop_Click" Margin="0,0,7,0" Padding="14,7" Background="#633D45" Foreground="White" BorderThickness="0"/>
    <Button Content="הפעלה מחדש" Click="Restart_Click" Margin="0,0,7,0" Padding="14,7"/>
    <Button Content="בנייה מחדש" Click="Build_Click" Margin="0,0,7,0" Padding="14,7"/>
    <TextBlock Text="פעולות מהירות" Foreground="#D9E0EE" VerticalAlignment="Center" FontSize="11" Margin="0,0,15,0"/>
   </DockPanel>
  </Border>
  <StackPanel Visibility="Collapsed">
   <ListView x:Name="InstallationsList" SelectionChanged="InstallationsList_SelectionChanged"/>
   <Button x:Name="StartButton"/><Button x:Name="StopButton"/><Button x:Name="RestartButton"/><Button x:Name="BuildButton"/>
   <Button x:Name="UpgradeButton"/><Button x:Name="PackagesButton"/><Button x:Name="BackupsButton"/>
   <Button x:Name="DatabaseButton"/><Button x:Name="LogsButton"/><Button x:Name="SecurityButton"/>
  </StackPanel>
 </Grid>
</Window>