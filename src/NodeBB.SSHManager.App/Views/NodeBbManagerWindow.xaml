<Window x:Class="NodeBB.SSHManager.Views.NodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
 Title="{loc:Tr View_9d6dc942}" Width="1180" Height="850" MinWidth="940" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" FlowDirection="RightToLeft" FontFamily="Segoe UI Variable, Segoe UI">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#111A2B" Offset="0"/><GradientStop Color="#526BDF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="TileButton" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#202E45"/>
   <Setter Property="BorderBrush" Value="#E4EAF2"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="19"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}"
      RenderTransformOrigin=".5,.5">
     <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
     <Border.Effect><DropShadowEffect Color="#203451" BlurRadius="17" ShadowDepth="2" Opacity=".06"/></Border.Effect>
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="#AABAF2"/><Setter TargetName="tile" Property="Background" Value="#FCFCFF"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="tile" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="tile" Property="Opacity" Value=".82"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="tile" Property="Opacity" Value=".42"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="#526BDF"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,10"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="21" Padding="24" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{loc:Tr Ui_NodeBB_Control_Center}" Foreground="#AFC0DD" FontSize="10" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Tr View_9d6dc942}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
     <TextBlock x:Name="ServerLabel" Foreground="#D0DAEA" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="{loc:Tr View_6a69ade3}" Click="Terminal_Click" Padding="17,11"
            Background="#FFFFFF" Foreground="#243A60" BorderThickness="0" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F1" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,0,17">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{loc:Tr View_7e8268ff}" Foreground="#8794A8" FontSize="10" FontWeight="SemiBold"/>
     <TextBlock x:Name="SelectedInstallationText" Text="{loc:Tr View_7e531ae3}" Foreground="#202E45" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
    </StackPanel>
    <ComboBox x:Name="InstallationPicker" Grid.Column="1" Width="220" Height="39" Margin="10,0"
      Padding="8" VerticalContentAlignment="Center" SelectionChanged="InstallationPicker_SelectionChanged" DisplayMemberPath="Path"/>
    <TextBox x:Name="ManualPathTextBox" Grid.Column="2" Width="190" Height="39" Margin="0,0,8,0"
      Padding="8" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
      ToolTip="{loc:Tr NodeBB_ManualPathHint}"/>
    <Button Grid.Column="3" x:Name="AddInstallationButton" Content="{loc:Tr NodeBB_ManualAddButton}"
      Click="AddInstallation_Click" Padding="13,10" Margin="0,0,8,0"
      Background="#EAF7F0" Foreground="#176B49" BorderBrush="#CBE9D9" VerticalAlignment="Center"/>
    <Button Grid.Column="4" x:Name="DiscoverButton" Content="{loc:Tr View_75657594}" Click="Discover_Click" Padding="13,10"
            Background="#EEF2FF" Foreground="#344CC2" BorderBrush="#D9E1FF" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="2,0,2,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{loc:Tr View_7211c6eb}" FontSize="20" FontWeight="Bold" Foreground="#1B2940"/>
    <TextBlock Text="{loc:Tr View_933e5e64}" FontSize="11" Foreground="#8290A5" Margin="0,4,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#EDF2FA" CornerRadius="11" Padding="12,8" VerticalAlignment="Center" MaxWidth="370">
    <TextBlock x:Name="StatusText" Foreground="#50617A" FontSize="11" TextWrapping="Wrap"/>
   </Border>
  </Grid>

  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <UniformGrid Columns="3" Rows="3">
    <Button Style="{StaticResource TileButton}" Click="Packages_Click" Margin="0,0,11,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_1ac360e}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#EEF1FF" CornerRadius="12" Width="43" Height="43"><TextBlock Text="▦" FontSize="23" Foreground="#526BDF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_2e260059}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_cfefc77f}" Foreground="#8794A8" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Backups_Click" Margin="5,0,6,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_b67740c2}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#EAF7F0" CornerRadius="12" Width="43" Height="43"><TextBlock Text="◫" FontSize="23" Foreground="#16865A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_7fe5f6c5}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_32ff6063}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Upgrade_Click" Margin="6,0,0,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_b8c4b05}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="12" Width="43" Height="43"><TextBlock Text="↥" FontSize="23" Foreground="#B76E12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_afb9af5f}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_a8beeb91}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Logs_Click" Margin="0,0,11,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_f0cee563}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#F0EBFF" CornerRadius="12" Width="43" Height="43"><TextBlock Text="≋" FontSize="23" Foreground="#7654C8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_bfac209d}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_5c9de13}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Database_Click" Margin="5,0,6,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_2c11e6bc}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#E8F5FA" CornerRadius="12" Width="43" Height="43"><TextBlock Text="◉" FontSize="23" Foreground="#2784A5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_3a27971e}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_33c659f}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Security_Click" Margin="6,0,0,11">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_2b8b8c66}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#FFF0F0" CornerRadius="12" Width="43" Height="43"><TextBlock Text="◇" FontSize="23" Foreground="#C34B4B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_fc3eff42}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_92b8e05}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Monitoring_Click" Margin="0,0,11,0">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_ebe2e84}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#EAF7F0" CornerRadius="12" Width="43" Height="43"><TextBlock Text="⌁" FontSize="23" Foreground="#16865A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_8346d9ce}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_ee6d6660}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Diagnostics_Click" Margin="5,0,6,0">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_699c61f3}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#EEF1FF" CornerRadius="12" Width="43" Height="43"><TextBlock Text="⌕" FontSize="23" Foreground="#526BDF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_e531a66a}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_a84ddda6}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Style="{StaticResource TileButton}" Click="Services_Click" Margin="6,0,0,0">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{loc:Tr View_6ec1b935}" FontSize="10" Foreground="#8492A8" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#F1F3F7" CornerRadius="12" Width="43" Height="43"><TextBlock Text="⚙" FontSize="22" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </Grid>
      <TextBlock Text="{loc:Tr View_fb49f534}" FontSize="16" FontWeight="Bold" Margin="0,14,0,5"/>
      <TextBlock Text="{loc:Tr View_cd3c72e7}" Foreground="#8794A8" FontSize="11"/>
     </StackPanel>
    </Button>
   </UniformGrid>
  </ScrollViewer>

  <Border Grid.Row="4" Background="#17263E" CornerRadius="15" Padding="12,11" Margin="0,14,0,0">
   <DockPanel LastChildFill="True">
    <TextBlock Text="{loc:Tr View_c603c62b}" Foreground="#D9E3F2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="{loc:Tr View_28e6401b}" Click="Start_Click" Margin="0,0,7,0" Padding="14,8" Background="#245743" Foreground="White" BorderThickness="0"/>
     <Button Content="{loc:Tr View_44dbbd04}" Click="Stop_Click" Margin="0,0,7,0" Padding="14,8" Background="#6A3F49" Foreground="White" BorderThickness="0"/>
     <Button Content="{loc:Tr View_2d109534}" Click="Restart_Click" Margin="0,0,7,0" Padding="14,8"/>
     <Button Content="{loc:Tr View_b8768af1}" Click="Build_Click" Margin="0" Padding="14,8"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <StackPanel Visibility="Collapsed">
   <ListView x:Name="InstallationsList" SelectionChanged="InstallationsList_SelectionChanged"/>
   <Button x:Name="StartButton"/><Button x:Name="StopButton"/><Button x:Name="RestartButton"/><Button x:Name="BuildButton"/>
   <Button x:Name="UpgradeButton"/><Button x:Name="PackagesButton"/><Button x:Name="BackupsButton"/>
   <Button x:Name="DatabaseButton"/><Button x:Name="LogsButton"/><Button x:Name="SecurityButton"/>
  </StackPanel>
 </Grid>
</Window>