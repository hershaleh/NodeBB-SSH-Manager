<Window x:Class="NodeBB.SSHManager.Views.NodeBbManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ניהול NodeBB" Width="820" Height="580" MinWidth="650" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0">
   <TextBlock Text="ניהול התקנות NodeBB" FontSize="23" FontWeight="Bold" Foreground="#182338"/>
   <TextBlock x:Name="ServerLabel" Foreground="#778399" Margin="0,5,0,0"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,18,0,12">
   <Button x:Name="DiscoverButton" Content="סרוק שרת לאיתור NodeBB" Click="Discover_Click" Padding="16,9"/>
   <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
  </DockPanel>
  <ListView x:Name="InstallationsList" Grid.Row="2">
   <ListView.View><GridView>
    <GridViewColumn Header="נתיב התקנה" Width="530" DisplayMemberBinding="{Binding Path}"/>
    <GridViewColumn Header="גרסה" Width="120" DisplayMemberBinding="{Binding Version}"/>
   </GridView></ListView.View>
  </ListView>
  <WrapPanel Grid.Row="3" Margin="0,14,0,0">
   <Button Content="הפעל" Click="Start_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="עצור" Click="Stop_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="הפעל מחדש" Click="Restart_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="בנייה מחדש" Click="Build_Click" Padding="18,9" Background="#FFF4E5" Foreground="#9A5700" Margin="0,0,8,0"/>
   <Button Content="תוספים ועיצובים" Click="Packages_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="גיבויים" Click="Backups_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="מסד נתונים" Click="Database_Click" Padding="18,9" Margin="0,0,8,0"/>
   <Button Content="לוגים" Click="Logs_Click" Padding="18,9" Margin="0,0,8,0"/>\n   <Button Content="אבטחה" Click="Security_Click" Padding="18,9"/>
  </WrapPanel>
 </Grid>
</Window>
