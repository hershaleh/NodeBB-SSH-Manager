<Window x:Class="NodeBB.SSHManager.Views.NodeBbUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NodeBB.SSHManager.Localization"
        Title="{loc:Tr View_f57ec38c}" Width="900" Height="900" MinWidth="720" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#F3F6FC" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#17243B" CornerRadius="19" Padding="21" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Tr View_37e505f3}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="InstallationLabel" Foreground="#B9C6DA" FontSize="11" Margin="0,7,0,0"/>
                    <TextBlock Text="{loc:Tr View_470cf74e}" Foreground="#8FA3C1" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="54" Height="54" Background="#293B5C" CornerRadius="15">
                    <TextBlock Text="⇧" FontSize="31" Foreground="#B5C1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="{loc:Tr View_fc4c345d}" Click="Refresh_Click" Padding="16,10" Background="#4F63D9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Border Grid.Column="1" Background="#E8EEF8" CornerRadius="10" Padding="12,8" Margin="12,0,0,0">
                <TextBlock x:Name="StatusText" Foreground="#42536D" FontSize="11" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel>
                <Border Background="#101827" CornerRadius="15" Padding="17" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_16a3bf7a}" Foreground="#E7EDF7" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{loc:Tr View_a46f86f4}" Foreground="#8799B4" FontSize="10" Margin="0,4,0,11"/>
                        <TextBlock x:Name="PreflightText" Text="{loc:Tr View_5365baf7}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Foreground="#C8D7ED" FontSize="11" LineHeight="19"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF5E8" BorderBrush="#F3D6A7" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_db6b4650}" FontSize="13" FontWeight="Bold" Foreground="#8A4B08"/>
                        <TextBlock Text="לפני עצירת NodeBB נוצרים גיבוי מוצפן של מסד הנתונים וגיבוי מוצפן של config.json, קובצי התצורה והעלאות. התוכן מפוענח ונבדק מול המקור. אם יצירה או אימות נכשלים, השדרוג לא יתחיל. מיגרציות מסד נתונים אינן מתבטלות אוטומטית; במקרה כשל NodeBB יישאר עצור." TextWrapping="Wrap" Foreground="#8A5A1B" FontSize="11" LineHeight="18" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr View_b6247f5e}" FontSize="16" FontWeight="Bold" Foreground="#23324A" Margin="0,0,0,13"/>
                        <TextBlock Text="{loc:Tr View_5542331b}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="TargetTagBox" Padding="11" Height="41" Margin="0,6,0,13" FontSize="13" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{loc:Tr View_ef950040}" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupFolderBox" Padding="10" Height="39" IsReadOnly="True" TextWrapping="NoWrap" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="1" Content="{loc:Tr View_d17bd808}" Click="BrowseBackupFolder_Click" Padding="15,8" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="סיסמת הצפנה (לפחות 12 תווים)" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="BackupPasswordBox" Padding="10" Height="39" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="אימות סיסמה" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="BackupPasswordConfirmBox" Padding="10" Height="39" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="RedisScopeWarningCheck" Margin="0,15,0,0" Visibility="Collapsed" Foreground="#9A5B13">
                            <TextBlock Text="אני מבין שגיבוי Redis כולל את כל שרת Redis וכל המסדים הלוגיים שבו, ולא רק את NodeBB; שחזור Redis עדיין דורש פעולה ידנית." TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="MigrationWarningCheck" Margin="0,11,0,0" Foreground="#52627A">
                            <TextBlock Text="אני מבין שמיגרציות מסד נתונים אינן מתבטלות אוטומטית במקרה כשל." TextWrapping="Wrap"/>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <TextBlock Text="הגיבויים נוצרים לפני עצירת NodeBB. השדרוג יתחיל רק לאחר שכל בדיקות המוכנות והגיבוי יעברו בהצלחה." Foreground="#718096" FontSize="10" TextWrapping="Wrap" Margin="3,12,3,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button x:Name="UpgradeButton" Content="{loc:Tr View_232d017d}" Click="Upgrade_Click" Padding="19,11" Background="#4F63D9" Foreground="White" BorderThickness="0" FontWeight="SemiBold" IsEnabled="False"/>
            <Button Content="סגור" Click="Close_Click" Padding="19,11" Margin="9,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>