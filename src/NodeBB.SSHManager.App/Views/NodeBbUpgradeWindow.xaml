<Window x:Class="NodeBB.SSHManager.Views.NodeBbUpgradeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="שדרוג NodeBB" Width="760" Height="690" MinWidth="650" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="בדיקת מוכנות ושדרוג NodeBB" FontSize="23" FontWeight="Bold" Foreground="#182338"/>
   <TextBlock x:Name="InstallationLabel" Foreground="#778399" Margin="0,5,0,0"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,16,0,12">
   <Button x:Name="RefreshButton" Content="בדוק שוב" Click="Refresh_Click" Padding="14,8"/>
   <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399" Margin="12,0,0,0"/>
  </DockPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Background="White" CornerRadius="8" Padding="14">
     <StackPanel>
      <TextBlock Text="תוצאות בדיקת מוכנות" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="PreflightText" Text="מבצע בדיקות..." TextWrapping="Wrap" FontFamily="Consolas"/>
     </StackPanel>
    </Border>
    <Border Background="#FFF4E5" CornerRadius="8" Padding="14" Margin="0,12,0,0">
     <TextBlock TextWrapping="Wrap" Foreground="#805000">חשוב: לפני השדרוג יש ליצור גיבוי מסד נתונים וגיבוי קבצים הכולל config.json והעלאות. השדרוג מריץ מיגרציות מסד נתונים; אם הן נכשלות, לא ניתן להבטיח חזרה אוטומטית. במקרה כשל NodeBB יישאר עצור כדי למנוע הפעלה במצב לא עקבי.</TextBlock>
    </Border>
    <TextBlock Text="תגית גרסה מדויקת (למשל v4.19.1)" FontWeight="SemiBold" Margin="0,14,0,4"/>
    <TextBox x:Name="TargetTagBox" Padding="10" FontSize="14"/>
    <CheckBox x:Name="DatabaseBackupCheck" Content="יצרתי גיבוי עדכני של מסד הנתונים ואני יודע היכן הוא שמור" Margin="0,12,0,0"/>
    <CheckBox x:Name="FilesBackupCheck" Content="יצרתי גיבוי קבצים, הגדרות והעלאות של התקנת NodeBB" Margin="0,8,0,0"/>
    <CheckBox x:Name="MigrationWarningCheck" Content="אני מבין שמיגרציות מסד נתונים אינן מתבטלות אוטומטית במקרה כשל" Margin="0,8,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
   <Button x:Name="UpgradeButton" Content="בצע שדרוג" Click="Upgrade_Click" Padding="18,10" Background="#294A9B" Foreground="White" BorderThickness="0" IsEnabled="False"/>
   <Button Content="סגור" Click="Close_Click" Padding="18,10" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>