<Window x:Class="NodeBB.SSHManager.Views.NodeBbUpgradeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="שדרוג NodeBB" Width="780" Height="790" MinWidth="680" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="בדיקת מוכנות ושדרוג NodeBB" FontSize="23" FontWeight="Bold" Foreground="#182338"/>
   <TextBlock x:Name="InstallationLabel" Foreground="#778399" Margin="0,5,0,0"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,16,0,12">
   <Button x:Name="RefreshButton" Content="בדוק שוב" Click="Refresh_Click" Padding="14,8"/>
   <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399" Margin="12,0,0,0"/>
  </DockPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Background="White" CornerRadius="8" Padding="14">
     <StackPanel>
      <TextBlock Text="תוצאות בדיקת מוכנות" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="PreflightText" Text="מבצע בדיקות..." TextWrapping="Wrap" FontFamily="Consolas"/>
     </StackPanel>
    </Border>
    <Border Background="#FFF4E5" CornerRadius="8" Padding="14" Margin="0,12,0,0">
     <TextBlock TextWrapping="Wrap" Foreground="#805000">התוכנה תיצור לפני השדרוג גיבוי מוצפן של מסד הנתונים וגיבוי מוצפן של config.json, קובצי התצורה והעלאות, ותבדוק שפענוח הגיבויים מחזיר את התוכן המקורי. אם גיבוי או אימות ייכשלו, השדרוג לא יתחיל. מיגרציות מסד נתונים אינן מתבטלות אוטומטית; במקרה כשל NodeBB יישאר עצור.</TextBlock>
    </Border>
    <TextBlock Text="תגית גרסה מדויקת (למשל v4.19.1)" FontWeight="SemiBold" Margin="0,14,0,4"/>
    <TextBox x:Name="TargetTagBox" Padding="10" FontSize="14"/>
    <TextBlock Text="תיקייה לשמירת הגיבויים המוצפנים" FontWeight="SemiBold" Margin="0,14,0,4"/>
    <DockPanel LastChildFill="True">
     <Button Content="עיון..." Click="BrowseBackupFolder_Click" Padding="14,7" DockPanel.Dock="Left" Margin="0,0,8,0"/>
     <TextBox x:Name="BackupFolderBox" Padding="9" IsReadOnly="True" TextWrapping="NoWrap"/>
    </DockPanel>
    <TextBlock Text="סיסמת הצפנה לגיבויים (לפחות 12 תווים)" FontWeight="SemiBold" Margin="0,12,0,4"/>
    <PasswordBox x:Name="BackupPasswordBox" Padding="9"/>
    <TextBlock Text="אימות סיסמה" FontWeight="SemiBold" Margin="0,8,0,4"/>
    <PasswordBox x:Name="BackupPasswordConfirmBox" Padding="9"/>
    <CheckBox x:Name="RedisScopeWarningCheck" Content="אני מבין שגיבוי Redis כולל את כל שרת Redis וכל המסדים הלוגיים שבו, ולא רק את NodeBB; שחזור Redis עדיין דורש פעולה ידנית." Margin="0,10,0,0" Visibility="Collapsed" Foreground="#9A5B13"/>
    <CheckBox x:Name="MigrationWarningCheck" Content="אני מבין שמיגרציות מסד נתונים אינן מתבטלות אוטומטית במקרה כשל" Margin="0,10,0,0"/>
    <TextBlock Text="הגיבויים נוצרים אוטומטית לפני עצירת NodeBB. אם אחד השלבים ייכשל, השדרוג לא יתחיל." TextWrapping="Wrap" Foreground="#52627A" Margin="0,10,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
   <Button x:Name="UpgradeButton" Content="צור גיבויים ובצע שדרוג" Click="Upgrade_Click" Padding="18,10" Background="#294A9B" Foreground="White" BorderThickness="0" IsEnabled="False"/>
   <Button Content="סגור" Click="Close_Click" Padding="18,10" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>