<Window x:Class="NodeBB.SSHManager.Views.FleetReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מלאי שרתים ובדיקת מוכנות" Width="1450" Height="820" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="מלאי שרתים ובדיקת מוכנות" FontSize="24" FontWeight="Bold" Foreground="#18243A"/>
                <TextBlock x:Name="SubtitleText" Text="זיהוי סביבת השרת והכלים הנדרשים לתחזוקה — רק בחיבורי SSH שכבר אומתו"
                           Foreground="#718096" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="ייצוא CSV" Click="Export_Click" Padding="15,9" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="סרוק שרתים מחוברים" Click="Refresh_Click" Padding="15,9"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="TotalLabel" Text="שרתים במאגר" Foreground="#718096"/><TextBlock x:Name="TotalCount" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="ConnectedLabel" Text="נסרקו בהצלחה" Foreground="#718096"/><TextBlock x:Name="ConnectedCount" FontSize="25" FontWeight="Bold" Foreground="#16865D"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="ReviewLabel" Text="דורשים בדיקה" Foreground="#718096"/><TextBlock x:Name="ReviewCount" FontSize="25" FontWeight="Bold" Foreground="#B7791F"/></StackPanel></Border>
            <Border Background="White" CornerRadius="12" Padding="14"><StackPanel><TextBlock x:Name="OfflineLabel" Text="לא מחוברים / נכשלו" Foreground="#718096"/><TextBlock x:Name="OfflineCount" FontSize="25" FontWeight="Bold" Foreground="#C05656"/></StackPanel></Border>
        </UniformGrid>
        <DataGrid x:Name="InventoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                  RowBackground="White" AlternatingRowBackground="#F8FAFD" BorderBrush="#E3E9F1"
                  BorderThickness="1" SelectionMode="Single" FlowDirection="RightToLeft" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="שרת" Binding="{Binding ServerName}" Width="1.1*"/>
                <DataGridTextColumn Header="כתובת" Binding="{Binding Endpoint}" Width="1.1*"/>
                <DataGridTextColumn Header="מצב" Binding="{Binding State}" Width="1.1*"/>
                <DataGridTextColumn Header="מערכת הפעלה" Binding="{Binding OperatingSystem}" Width="1.5*"/>
                <DataGridTextColumn Header="Node.js" Binding="{Binding Node}" Width="0.8*"/>
                <DataGridTextColumn Header="npm" Binding="{Binding Npm}" Width="0.8*"/>
                <DataGridTextColumn Header="Git" Binding="{Binding Git}" Width="0.8*"/>
                <DataGridTextColumn Header="MongoDB" Binding="{Binding Mongo}" Width="1*"/>
                <DataGridTextColumn Header="Redis" Binding="{Binding Redis}" Width="1*"/>
                <DataGridTextColumn Header="שירות / חבילות" Binding="{Binding InitSystem}" Width="1*"/>
                <DataGridTextColumn Header="ממצאים והמלצות" Binding="{Binding Findings}" Width="2.8*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#718096" FontSize="11" Margin="0,12,0,0"
                   Text="לא מתבצעת התחברות אוטומטית. הסריקה אינה משנה דבר בשרת."/>
    </Grid>
</Window>