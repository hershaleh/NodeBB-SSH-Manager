<Window x:Class="NodeBB.SSHManager.Views.SystemServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שירותי מערכת" Width="1000" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FlowDirection="RightToLeft">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ניהול שירותי מערכת" FontSize="24" FontWeight="Bold" Foreground="#182338"/>
            <TextBlock x:Name="ServerLabel" Foreground="#778399" Margin="0,5,0,0"/>
            <TextBlock Text="הפעולות משנות את מצב השירות בשרת. נדרשת הרשאת root או sudo ללא סיסמה." Foreground="#9A5B13" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="רענון" Click="Refresh_Click" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="הפעלה" Tag="start" Click="Action_Click" Padding="14,8" Margin="0,0,8,0" Background="#E7F7ED" Foreground="#17633B" BorderThickness="0"/>
                <Button Content="עצירה" Tag="stop" Click="Action_Click" Padding="14,8" Margin="0,0,8,0" Background="#FFF0F0" Foreground="#B42318" BorderThickness="0"/>
                <Button Content="אתחול" Tag="restart" Click="Action_Click" Padding="14,8"/>
            </StackPanel>
            <TextBlock x:Name="ManagerText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#778399"/>
        </DockPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E7EBF2" BorderThickness="1" CornerRadius="12" Padding="10">
            <ListView x:Name="ServicesList" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="שם השירות" Width="330" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="מצב" Width="180" DisplayMemberBinding="{Binding State}"/>
                        <GridViewColumn Header="פרטים" Width="380" DisplayMemberBinding="{Binding Details}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#778399" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>