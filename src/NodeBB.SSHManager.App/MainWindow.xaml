<Window x:Class="NodeBB.SSHManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NodeBB SSH Manager" Width="1220" Height="860" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F2F5FB"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14233B" Offset="0"/>
            <GradientStop Color="#263F70" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#34445F"/>
            <Setter Property="BorderBrush" Value="#DFE6F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F7FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C7EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="#4968E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4968E8"/>
            <Setter Property="Padding" Value="19,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3654D1"/>
                    <Setter Property="BorderBrush" Value="#3654D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServerCardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="White" BorderBrush="#E5EAF3" BorderThickness="1"
                                CornerRadius="16" Padding="17">
                            <Border.Effect><DropShadowEffect Color="#243858" BlurRadius="15" ShadowDepth="2" Opacity=".055"/></Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#B7C6F1"/>
                                <Setter TargetName="Card" Property="Background" Value="#FBFCFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#6079E8"/>
                                <Setter TargetName="Card" Property="Background" Value="#F7F8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="22" Padding="24" Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="13" Background="#FFFFFF" Opacity=".13" Margin="0,0,13,0">
                            <TextBlock Text="N" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NodeBB SSH Manager" FontSize="23" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="מרכז שליטה מאובטח לניהול שרתי NodeBB" FontSize="12" Foreground="#C7D3E8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="כל השרתים, החיבורים ופעולות התחזוקה — במקום אחד."
                               Foreground="#D8E2F1" FontSize="12" Margin="0,18,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="⋯" FontSize="23" Width="43" Height="43" Padding="0"
                            Background="#FFFFFF" Foreground="#233858" BorderThickness="0"
                            Click="GlobalMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu FlowDirection="RightToLeft">
                                <MenuItem Header="ייבוא פרופילי שרתים" Click="ImportProfiles_Click"/>
                                <MenuItem Header="ייצוא פרופילי שרתים" Click="ExportProfiles_Click"/>
                                <MenuItem Header="היסטוריית פעולות מכל השרתים" Click="AllServerHistory_Click"/>
                                <Separator/>
                                <MenuItem Header="דוח אבחון האפליקציה" Click="Diagnostics_Click"/>
                                <MenuItem Header="בדיקת ניטור שרת" Click="ServerMonitoring_Click"/>
                                <MenuItem Header="אבחון שרת" Click="ServerDiagnostics_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Grid.Column="1" Content="+ הוסף שרת" Style="{StaticResource PrimaryAction}"
                            Margin="10,0,0,0" Background="#FFFFFF" Foreground="#2947B5" BorderBrush="#FFFFFF"
                            Click="AddServer_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="2,0,2,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="תמונת מצב" FontSize="21" FontWeight="Bold" Foreground="#1B2940"/>
                <TextBlock Text="ניהול פרופילי השרתים שלך" FontSize="12" Foreground="#8290A5" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7F0" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#159765" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="פרטי התחברות מוגנים בהצפנת Windows" Foreground="#16734B" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="16" Margin="0,0,9,0">
                <StackPanel><TextBlock Text="שרתים שמורים" Foreground="#8390A4" FontSize="11"/><TextBlock x:Name="ServerCountText" Text="0" Foreground="#233653" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="ServerTotalText" Text="שרתים במאגר" Foreground="#A0AABB" FontSize="10"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="16" Margin="5,0">
                <StackPanel><TextBlock Text="חיבורים פעילים" Foreground="#8390A4" FontSize="11"/><TextBlock x:Name="ConnectedCountText" Text="0" Foreground="#16865A" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="חיבורי SSH פתוחים" Foreground="#A0AABB" FontSize="10"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="15" Padding="16" Margin="9,0,0,0">
                <StackPanel><TextBlock Text="אישורים שמורים" Foreground="#8390A4" FontSize="11"/><TextBlock x:Name="SavedCredentialCountText" Text="0" Foreground="#4968D8" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="מוגנים באמצעות DPAPI" Foreground="#A0AABB" FontSize="10"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E3E9F2" BorderThickness="1"
                CornerRadius="20" Padding="20">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                    <Border Width="78" Height="78" Background="#EEF1FF" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Text="⌁" FontSize="43" Foreground="#4968E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="עדיין אין שרתים ברשימה" FontSize="21" FontWeight="Bold" Foreground="#202E45" HorizontalAlignment="Center"/>
                    <TextBlock Text="הוסף פרטי חיבור לשרת NodeBB כדי להתחיל לנהל תוספים, גיבויים, שירותים וקבצים."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#7D8BA0" FontSize="13" Margin="0,10,0,22"/>
                    <Button Content="הוספת שרת ראשון" Style="{StaticResource PrimaryAction}" Click="AddServer_Click" Padding="20,12"/>
                    <TextBlock Text="הסיסמאות נשמרות בהצפנת Windows DPAPI, אם תבחר בכך."
                               Foreground="#9AA5B5" FontSize="11" Margin="0,15,0,0"/>
                </StackPanel>

                <DockPanel x:Name="ServerListPanel" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="השרתים שלי" FontSize="17" FontWeight="Bold" Foreground="#23334D"/>
                            <TextBlock Text="לחיצה כפולה פותחת את סביבת הניהול של השרת" FontSize="11" Foreground="#8A97AA" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerSearchBox" Height="39" Padding="13,8" FontSize="12"
                                     BorderBrush="#E1E7F0" BorderThickness="1" Background="#F8FAFD"
                                     ToolTip="חיפוש לפי שם שרת, כתובת או משתמש" TextChanged="ServerSearchBox_TextChanged"/>
                            <TextBlock x:Name="VisibleServerCountText" Grid.Column="1" Text="0 שרתים"
                                       Foreground="#8794A8" FontSize="10" VerticalAlignment="Center" Margin="12,0,2,0"/>
                        </Grid>
                    </Grid>
                    <ListBox x:Name="ServersList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ServersList_SelectionChanged"
                             MouseDoubleClick="ServersList_MouseDoubleClick"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource ServerCardItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="14" Background="#EEF1FF" Margin="0,0,14,0">
                                        <TextBlock Text="⌘" FontSize="22" Foreground="#4968E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#202E45"/>
                                        <TextBlock Text="{Binding HostDisplay}" Foreground="#77869C" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Username}" Foreground="#9AA5B5" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                        <Border Background="#EAF7F0" CornerRadius="11" Padding="10,5">
                                            <TextBlock Text="{Binding ConnectionStatusLabel}" Foreground="#16734B" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding AuthenticationLabel}" Foreground="#7C899D" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="⋯" FontSize="22" Width="39" Height="39" Padding="0"
                                            Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="ServerRowMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu FlowDirection="RightToLeft" Opened="ServerContextMenu_Opened">
                                                <MenuItem Header="פתח סביבת ניהול" Click="ServerRow_Open_Click"/>
                                                <MenuItem Header="בדיקת חיבור" Click="TestConnection_Click"/>
                                                <MenuItem Header="עריכת פרופיל" Click="EditServer_Click"/>
                                                <MenuItem Header="שכח פרטי התחברות" Click="ForgetCredential_Click"/>
                                                <Separator/>
                                                <MenuItem Header="הסר פרופיל מהמחשב" Click="RemoveServer_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.ToolTip>פעולות לשרת</Button.ToolTip>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="NODEBB SSH MANAGER  ·  SECURE SERVER CONTROL" Foreground="#A0AABB" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedServerText" Grid.Column="1" Text="בחר שרת מהרשימה" Foreground="#77869C" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedServerStatusText" Visibility="Collapsed"/>
        </Grid>

        <!-- Existing command handlers remain available to the application. -->
        <StackPanel Visibility="Collapsed">
            <Button x:Name="ConnectButton" Click="Connect_Click"/>
            <Button x:Name="DisconnectButton" Click="Disconnect_Click"/>
            <Button x:Name="TerminalButton" Click="OpenTerminal_Click"/>
            <Button x:Name="FilesButton" Click="OpenFiles_Click"/>
            <Button x:Name="ManageButton" Click="ManageNodeBb_Click"/>
            <Button x:Name="TestButton" Click="TestConnection_Click"/>
            <Button x:Name="RemoveButton" Click="RemoveServer_Click"/>
            <Button x:Name="EditButton" Click="EditServer_Click"/>
            <Button x:Name="ForgetCredentialButton" Click="ForgetCredential_Click"/>
            <Button Click="ServerMonitoring_Click"/>
            <Button Click="ServerDiagnostics_Click"/>
            <Button Click="SystemServices_Click"/>
            <Button Click="Diagnostics_Click"/>
            <Button Click="ImportProfiles_Click"/>
            <Button Click="ExportProfiles_Click"/>
        </StackPanel>
    </Grid>
</Window>