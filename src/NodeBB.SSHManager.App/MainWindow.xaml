<Window x:Class="NodeBB.SSHManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NodeBB SSH Manager"
        Width="1180" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FA"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#E4E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F7FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9D3F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="#405CE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#405CE8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#304BD0"/>
                    <Setter Property="BorderBrush" Value="#304BD0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServerCardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="White" BorderBrush="#E5E9F1" BorderThickness="1"
                                CornerRadius="15" Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#B9C7F5"/>
                                <Setter TargetName="Card" Property="Background" Value="#FCFCFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#526CE8"/>
                                <Setter TargetName="Card" Property="Background" Value="#F8F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="42,34,42,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="39" Height="39" CornerRadius="12" Background="#405CE8" Margin="0,0,12,0">
                        <TextBlock Text="N" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NodeBB Manager" FontSize="23" FontWeight="Bold" Foreground="#182338"/>
                        <TextBlock Text="מרכז ניהול שרתי NodeBB" FontSize="12" Foreground="#7B879A" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⋯" FontSize="23" Width="42" Height="42" Padding="0"
                        Style="{StaticResource QuietButton}" Click="GlobalMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu FlowDirection="RightToLeft">
                            <MenuItem Header="ייבוא פרופילי שרתים" Click="ImportProfiles_Click"/>
                            <MenuItem Header="ייצוא פרופילי שרתים" Click="ExportProfiles_Click"/>
                            <Separator/>
                            <MenuItem Header="דוח אבחון האפליקציה" Click="Diagnostics_Click"/>
                            <MenuItem Header="בדיקת ניטור שרת" Click="ServerMonitoring_Click"/>
                            <MenuItem Header="אבחון שרת" Click="ServerDiagnostics_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="+ הוסף שרת" Style="{StaticResource PrimaryAction}" Margin="10,0,0,0"
                        Padding="19,12" Click="AddServer_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="השרתים שלי" FontSize="25" FontWeight="Bold" Foreground="#182338"/>
                <TextBlock Text="בחר שרת כדי לפתוח את סביבת הניהול שלו. כל החיבורים נשמרים ומנוהלים בנפרד."
                           FontSize="13" Foreground="#7B879A" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EAF7F0" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#1B9B62" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="החיבורים מאובטחים" Foreground="#16734B" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E9F1" BorderThickness="1"
                CornerRadius="18" Padding="22">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                    <Border Width="76" Height="76" Background="#EEF1FF" CornerRadius="23" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="⌁" FontSize="42" Foreground="#405CE8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="עדיין אין שרתים ברשימה" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="הוסף פרטי חיבור לשרת NodeBB כדי להתחיל לנהל תוספים, גיבויים, שירותים וקבצים."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#7B879A" FontSize="13" Margin="0,10,0,22"/>
                    <Button Content="הוספת שרת ראשון" Style="{StaticResource PrimaryAction}" Click="AddServer_Click" Padding="20,12"/>
                    <TextBlock Text="הסיסמאות נשמרות בהצפנת Windows DPAPI, אם תבחר בכך."
                               Foreground="#98A2B3" FontSize="11" Margin="0,15,0,0"/>
                </StackPanel>

                <DockPanel x:Name="ServerListPanel" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerSearchBox" Height="40" Padding="13,9" FontSize="13"
                                 BorderBrush="#E5E9F1" BorderThickness="1" Background="#F8F9FC"
                                 ToolTip="חיפוש לפי שם שרת, כתובת או משתמש" TextChanged="ServerSearchBox_TextChanged"/>
                        <TextBlock x:Name="VisibleServerCountText" Grid.Column="1" Text="0 שרתים"
                                   Foreground="#8994A6" FontSize="11" VerticalAlignment="Center" Margin="16,0,2,0"/>
                    </Grid>
                    <ListBox x:Name="ServersList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ServersList_SelectionChanged"
                             MouseDoubleClick="ServersList_MouseDoubleClick"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource ServerCardItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="45" Height="45" CornerRadius="13" Background="#EEF1FF" Margin="0,0,14,0">
                                        <TextBlock Text="⌘" FontSize="22" Foreground="#405CE8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#202B40"/>
                                        <TextBlock Text="{Binding HostDisplay}" Foreground="#778399" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Username}" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                        <Border Background="#EAF7F0" CornerRadius="12" Padding="10,5"
                                                >
                                            <TextBlock Text="{Binding ConnectionStatusLabel}" Foreground="#16734B" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding AuthenticationLabel}" Foreground="#667085" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="⋯" FontSize="22" Width="38" Height="38" Padding="0"
                                            Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="ServerRowMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu FlowDirection="RightToLeft" Opened="ServerContextMenu_Opened">
                                                <MenuItem Header="פתח סביבת ניהול" Click="ServerRow_Open_Click"/>
                                                <MenuItem Header="בדיקת חיבור" Click="TestConnection_Click"/>
                                                <MenuItem Header="עריכת פרופיל" Click="EditServer_Click"/>
                                                <MenuItem Header="שכח פרטי התחברות" Click="ForgetCredential_Click"/>
                                                <Separator/>
                                                <MenuItem Header="הסר פרופיל מהמחשב" Click="RemoveServer_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.ToolTip>פעולות לשרת</Button.ToolTip>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,14,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="NodeBB SSH Manager" Foreground="#A0A9B8" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="לחיצה כפולה על שרת לפתיחת סביבת הניהול" Foreground="#8994A6" FontSize="11"/>
        </Grid>

        <!-- Hidden compatibility controls: existing tested workflows remain connected to their handlers. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="ServerCountText"/>
            <TextBlock x:Name="ConnectedCountText"/>
            <TextBlock x:Name="SavedCredentialCountText"/>
            <TextBlock x:Name="SelectedServerText"/>
            <TextBlock x:Name="SelectedServerStatusText"/>
            <TextBlock x:Name="ServerTotalText"/>
            <Button x:Name="ConnectButton" Click="Connect_Click"/>
            <Button x:Name="DisconnectButton" Click="Disconnect_Click"/>
            <Button x:Name="TerminalButton" Click="OpenTerminal_Click"/>
            <Button x:Name="FilesButton" Click="OpenFiles_Click"/>
            <Button x:Name="ManageButton" Click="ManageNodeBb_Click"/>
            <Button x:Name="TestButton" Click="TestConnection_Click"/>
            <Button x:Name="RemoveButton" Click="RemoveServer_Click"/>
            <Button x:Name="EditButton" Click="EditServer_Click"/>
            <Button x:Name="ForgetCredentialButton" Click="ForgetCredential_Click"/>
            <Button Click="ServerMonitoring_Click"/>
            <Button Click="ServerDiagnostics_Click"/>
            <Button Click="SystemServices_Click"/>
            <Button Click="Diagnostics_Click"/>
            <Button Click="ImportProfiles_Click"/>
            <Button Click="ExportProfiles_Click"/>
        </StackPanel>
    </Grid>
</Window>